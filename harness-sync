#!/usr/bin/env python3
"""Sync a repo's agent-harness files from the public harness repo.

Each file under `template/` in the harness repo is mirrored to the same path
here. The last applied version of each file is kept in `.harness/base/<path>`,
so updates are shown as harness-to-harness diffs and applied with a 3-way
merge that keeps local edits.

  harness-sync init          set up this repo (new or existing)
  harness-sync check         one-line notice if the harness changed or config is unset
  harness-sync diff          show what the harness changed since the last apply
  harness-sync apply [path]  merge harness changes into local files (after approval)
"""
import datetime
import difflib
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPO_URL = os.environ.get("HARNESS_SYNC_REPO", "https://github.com/mattsilv/harness.git")
TEMPLATE = "template"
UNSET_MARKER = "set during setup"
CONFIG_FILE = "PROJECT_CONFIG.md"
MAINTENANCE_FILE = Path("docs/MAINTENANCE.md")
CACHE = Path.home() / ".cache" / "harness-sync"
CLONE = CACHE / "repo"
FETCHED = CACHE / "fetched"  # mtime = last successful fetch
REF = "refs/harness/latest"  # the harness default branch as last fetched
CHECK_CACHE_SECONDS = 3600
STATE = Path(".harness")
BASE = STATE / "base"
APPLIED = STATE / "version"  # harness VERSION last fully applied here
SOURCE = os.environ.get("HARNESS_SYNC_SOURCE")  # local template dir, to preview a harness branch


def git(*args):
    return subprocess.run(["git", "-C", str(CLONE), *args], capture_output=True,
                          text=True, check=True, timeout=30).stdout


def fetch(max_age=0):
    """Map file path -> content for every file under the harness template."""
    if SOURCE:
        root = Path(SOURCE)
        return {str(f.relative_to(root)): f.read_text()
                for f in sorted(root.rglob("*")) if f.is_file()}
    fresh = FETCHED.exists() and time.time() - FETCHED.stat().st_mtime < max_age
    if not (CLONE / ".git").exists():
        CACHE.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "clone", "-q", "--depth", "1", "--no-checkout", REPO_URL,
                        str(CLONE)], capture_output=True, check=True, timeout=30)
        git("update-ref", REF, "HEAD")
        FETCHED.touch()
    elif not (max_age and fresh):
        git("remote", "set-url", "origin", REPO_URL)
        git("fetch", "-q", "--depth", "1", "origin", f"+HEAD:{REF}")
        FETCHED.touch()
    names = git("ls-tree", "-r", "-z", "--name-only", REF, "--", TEMPLATE)
    return {n.removeprefix(TEMPLATE + "/"): git("show", f"{REF}:{n}")
            for n in names.split("\0") if n}


def upstream_version():
    """The harness VERSION number matching what fetch() returned, or "?"."""
    try:
        if SOURCE:
            return (Path(SOURCE).parent / "VERSION").read_text().strip()
        return git("show", f"{REF}:VERSION").strip()
    except Exception:
        return "?"


def versions():
    """"v3 → v4" for messages; the local side is "?" until the first apply."""
    local = (read(APPLIED) or "?").strip()
    return f"v{local} → v{upstream_version()}"


def read(p):
    return p.read_text() if p.exists() else None


def write(p, text):
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(text)


def changed(upstream):
    return [p for p, t in upstream.items() if read(BASE / p) != t]


def removed(upstream):
    if not BASE.exists():
        return []
    return [str(f.relative_to(BASE)) for f in BASE.rglob("*") if f.is_file()
            and str(f.relative_to(BASE)) not in upstream]


def unset_values():
    text = read(Path(CONFIG_FILE)) or ""
    labels = []
    for line in text.splitlines():
        if UNSET_MARKER in line.lower():
            m = re.search(r"\*\*(.+?):?\*\*", line)
            labels.append(m.group(1).rstrip(":") if m else line.strip("- ").strip())
    return labels


def report_local():
    """Flag unresolved merge conflicts and unset config values."""
    base_files = [f.relative_to(BASE) for f in BASE.rglob("*") if f.is_file()]
    conflicted = [str(p) for p in base_files if "<<<<<<< local" in (read(p) or "")]
    if conflicted:
        print(f"harness-sync: unresolved merge conflicts in {', '.join(conflicted)}; "
              "resolve them with the operator.")
        return
    labels = unset_values()
    if labels:
        print(f"harness-sync: {CONFIG_FILE} has unset values; ask the operator "
              f"for them before other work and record the answers: {', '.join(labels)}.")


def gh_cached(name, args):
    """JSON from `gh`, cached per repo for CHECK_CACHE_SECONDS; None on failure."""
    key = hashlib.sha1(str(Path.cwd().resolve()).encode()).hexdigest()[:12]
    cache = CACHE / f"{name}-{key}.json"
    if cache.exists() and time.time() - cache.stat().st_mtime < CHECK_CACHE_SECONDS:
        return json.loads(cache.read_text())
    r = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=15)
    if r.returncode:
        return None
    write(cache, r.stdout)
    return json.loads(r.stdout)


def report_ci_gate():
    """An `auto` merge policy is only safe if the default branch requires CI checks."""
    if not re.search(r"Merge policy:\*\*\s*`auto`", read(Path(CONFIG_FILE)) or ""):
        return
    try:
        rules = gh_cached("branch-rules", ["api", "repos/{owner}/{repo}/rules/branches/"
                                           + default_branch()])
    except Exception:
        rules = None
    if rules is None:
        print("harness-sync: merge policy is `auto` but required CI checks on the default "
              "branch could not be verified; treat merges as `on-request` until they are.")
    elif not any(r["type"] == "required_status_checks" for r in rules):
        print("harness-sync: merge policy is `auto` but the default branch requires no CI "
              "checks; treat merges as `on-request` and ask the operator to require CI.")


def default_branch():
    r = subprocess.run(["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"],
                       capture_output=True, text=True)
    return r.stdout.strip().removeprefix("origin/") or "main"


def maintenance_issue():
    """Tracking issue's labels and body via gh, cached per repo."""
    m = re.search(r"Maintenance tracking issue:\*\*\s*#(\d+)", read(Path(CONFIG_FILE)) or "")
    if not m:
        return None
    return gh_cached("maintenance", ["issue", "view", m.group(1), "--json",
                                     "number,body,labels"])


def report_maintenance():
    """Nag when the audit in docs/MAINTENANCE.md is overdue; the interval comes from that file."""
    days = re.search(r"(\d+) or more days ago", read(MAINTENANCE_FILE) or "")
    try:
        issue = maintenance_issue()
    except Exception:
        issue = None
    if not days or not issue:
        return
    if any("audit" in lbl["name"] for lbl in issue["labels"]):
        return  # claimed by a running audit
    last = re.search(r"Last completed:\**\s*(\S+)", issue["body"])
    date = re.match(r"\d{4}-\d{2}-\d{2}", last.group(1)) if last else None
    if date:
        age = (datetime.date.today() - datetime.date.fromisoformat(date.group(0))).days
        if age < int(days.group(1)):
            return
    print(f"harness-sync: maintenance audit overdue (last completed: "
          f"{last.group(1) if last else 'unknown'}); follow {MAINTENANCE_FILE} "
          f"and record results in #{issue['number']}.")


def cmd_check():
    if not STATE.is_dir():
        # Checkout predates the harness (or is on a stale branch) while origin has it.
        ref = f"origin/{default_branch()}"
        r = subprocess.run(["git", "cat-file", "-e", f"{ref}:{BASE}"], capture_output=True)
        if r.returncode == 0:
            print(f"harness-sync: this checkout lacks the harness that {ref} has, so its "
                  "rules are not loaded. Tell the operator before other work, and move to "
                  f"a branch or worktree based on an up-to-date {ref}.")
        return
    try:
        upstream = fetch(CHECK_CACHE_SECONDS)
    except Exception:
        upstream = None  # offline: stay quiet about the harness, still check config
    if upstream:
        files = changed(upstream) + [f"{p} (removed from harness)" for p in removed(upstream)]
        if files:
            print(f"harness-sync: harness changed ({versions()}; see CHANGELOG.md in "
                  f"the harness repo): {', '.join(files)}. Run "
                  "`harness-sync diff`, summarize the changes for the operator, and "
                  "run `harness-sync apply` only after they approve.")
    report_local()
    report_ci_gate()
    report_maintenance()


def cmd_diff():
    upstream = fetch()
    files = changed(upstream)
    if files:
        print(f"harness {versions()}")
    for p in files:
        old = read(BASE / p) or ""
        sys.stdout.writelines(difflib.unified_diff(
            old.splitlines(True), upstream[p].splitlines(True),
            f"a/{p} (last applied)", f"b/{p} (harness now)"))
    for p in removed(upstream):
        print(f"{p}: removed from the harness; delete it by hand if no longer wanted.")
    if not files:
        print("harness-sync: up to date.")


def merge(local, base, new):
    """3-way merge; returns (text, conflict_count)."""
    with tempfile.TemporaryDirectory() as d:
        paths = []
        for name, text in (("local", local), ("base", base), ("new", new)):
            f = Path(d) / name
            f.write_text(text)
            paths.append(str(f))
        r = subprocess.run(["git", "merge-file", "-p", "-L", "local", "-L",
                            "last-applied", "-L", "harness", *paths],
                           capture_output=True, text=True)
        if r.returncode < 0:
            sys.exit(f"git merge-file failed: {r.stderr}")
        return r.stdout, r.returncode


def cmd_apply(only):
    upstream = fetch()
    files = [p for p in changed(upstream) if not only or p in only]
    for p in files:
        local, base = read(Path(p)), read(BASE / p)
        if local is None or local == base:
            write(Path(p), upstream[p])
            print(f"updated {p}")
        else:
            text, conflicts = merge(local, base or "", upstream[p])
            write(Path(p), text)
            print(f"merged {p}" + (f" with {conflicts} conflict(s); resolve the "
                                   "markers by hand" if conflicts else ""))
        write(BASE / p, upstream[p])
    if not only or not changed(upstream):
        write(APPLIED, upstream_version() + "\n")
    if not files:
        print("harness-sync: nothing to apply.")
    report_local()
    if any("<<<<<<< local" in (read(Path(p)) or "") for p in upstream):
        sys.exit(1)  # stop callers (commit/merge chains) until conflicts are resolved


def cmd_init():
    upstream = fetch()
    for p, text in upstream.items():
        local = read(Path(p))
        if local is None:
            write(Path(p), text)
            print(f"created {p}")
        elif local != text:
            print(f"{p} already exists: merge the harness version from "
                  f"{BASE / p} into it by hand, removing anything it duplicates.")
        write(BASE / p, text)
    write(APPLIED, upstream_version() + "\n")
    claude = Path("CLAUDE.md")
    if not claude.exists():
        write(claude, "@AGENTS.md\n")
        print("created CLAUDE.md (imports AGENTS.md for Claude Code)")
    elif "@AGENTS.md" not in claude.read_text():
        print("CLAUDE.md exists: add an `@AGENTS.md` line so Claude Code loads the rules.")
    report_local()


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "check"
    try:
        if cmd == "check":
            cmd_check()
        elif cmd == "diff":
            cmd_diff()
        elif cmd == "apply":
            cmd_apply(set(args[1:]))
        elif cmd == "init":
            cmd_init()
        else:
            sys.exit(__doc__)
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as e:
        detail = e.stderr.decode() if isinstance(e.stderr, bytes) else e.stderr or ""
        detail = detail.strip()
        sys.exit(f"harness-sync: `{' '.join(map(str, e.cmd))}` failed"
                 f"{': ' + detail if detail else ''}. Check the network and retry; "
                 f"if it persists, delete {CLONE} to re-clone.")


if __name__ == "__main__":
    main()
