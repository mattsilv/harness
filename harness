#!/usr/bin/env python3
"""Sync a repo's agent-harness files from the public harness repo.

Each file under `template/` in the harness repo is mirrored to the same path
here. The last applied version of each file is kept in `.harness/base/<path>`,
so updates are shown as harness-to-harness diffs and applied with a 3-way
merge that keeps local edits.

  harness init          set up this repo (new or existing)
  harness check         one-line notice if the harness changed or config is unset
  harness diff          show what the harness changed since the last apply
  harness apply [path]  merge harness changes into local files (after approval)
  harness audit [n]     how often harness behaviors fired in recent local sessions
"""
import datetime
import difflib
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

REPO_URL = os.environ.get("HARNESS_SYNC_REPO", "https://github.com/mattsilv/harness.git")
TEMPLATE = "template"
UNSET_MARKER = "set during setup"
CONFIG_FILE = "PROJECT_CONFIG.md"
MAINTENANCE_FILE = Path("docs/MAINTENANCE.md")
CACHE = Path.home() / ".cache" / "harness-sync"
CLONE = CACHE / "repo"
FETCHED = CACHE / "fetched"  # mtime = last successful fetch
REF = "refs/harness/latest"  # the harness default branch as last fetched
CHECK_CACHE_SECONDS = 3600
STATE = Path(".harness")
BASE = STATE / "base"
APPLIED = STATE / "version"  # harness VERSION last fully applied here
SOURCE = os.environ.get("HARNESS_SYNC_SOURCE")  # local template dir, to preview a harness branch
CONTEXT_FILES = ("AGENTS.md", "CLAUDE.md", CONFIG_FILE)  # loaded every session
CONTEXT_WARN_BYTES = 20_000


def git(*args):
    return subprocess.run(["git", "-C", str(CLONE), *args], capture_output=True,
                          text=True, check=True, timeout=30).stdout


def strip_comments(text):
    """Drop maintainer-only comment lines (rule ids and rationale) from Markdown."""
    return re.sub(r"^[ \t]*<!--.*?-->[ \t]*\n", "", text, flags=re.M | re.S)


def fetch(max_age=0):
    """Map file path -> content for every file under the harness template."""
    return {p: strip_comments(t) if p.endswith(".md") else t
            for p, t in fetch_raw(max_age).items()}


def fetch_raw(max_age):
    if SOURCE:
        root = Path(SOURCE)
        return {str(f.relative_to(root)): f.read_text()
                for f in sorted(root.rglob("*")) if f.is_file()}
    fresh = FETCHED.exists() and time.time() - FETCHED.stat().st_mtime < max_age
    if not (CLONE / ".git").exists():
        CACHE.mkdir(parents=True, exist_ok=True)
        subprocess.run(["git", "clone", "-q", "--depth", "1", "--no-checkout", REPO_URL,
                        str(CLONE)], capture_output=True, check=True, timeout=30)
        git("update-ref", REF, "HEAD")
        FETCHED.touch()
    elif not (max_age and fresh):
        git("remote", "set-url", "origin", REPO_URL)
        git("fetch", "-q", "--depth", "1", "origin", f"+HEAD:{REF}")
        FETCHED.touch()
    names = git("ls-tree", "-r", "-z", "--name-only", REF, "--", TEMPLATE)
    return {n.removeprefix(TEMPLATE + "/"): git("show", f"{REF}:{n}")
            for n in names.split("\0") if n}


def upstream_version():
    """The harness VERSION number matching what fetch() returned, or "?"."""
    try:
        if SOURCE:
            return (Path(SOURCE).parent / "VERSION").read_text().strip()
        return git("show", f"{REF}:VERSION").strip()
    except Exception:
        return "?"


def versions():
    """"v3 → v4" for messages; the local side is "?" until the first apply."""
    local = (read(APPLIED) or "?").strip()
    return f"v{local} → v{upstream_version()}"


def read(p):
    return p.read_text() if p.exists() else None


def write(p, text):
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(text)


def changed(upstream):
    return [p for p, t in upstream.items() if read(BASE / p) != t]


def removed(upstream):
    if not BASE.exists():
        return []
    return [str(f.relative_to(BASE)) for f in BASE.rglob("*") if f.is_file()
            and str(f.relative_to(BASE)) not in upstream]


def unset_values():
    text = read(Path(CONFIG_FILE)) or ""
    labels = []
    for line in text.splitlines():
        if UNSET_MARKER in line.lower():
            m = re.search(r"\*\*(.+?):?\*\*", line)
            labels.append(m.group(1).rstrip(":") if m else line.strip("- ").strip())
    return labels


def report_context_size():
    """Warn when always-loaded root context grows past CONTEXT_WARN_BYTES."""
    total = sum(p.stat().st_size for name in CONTEXT_FILES
                if (p := Path(name)).exists())
    if total > CONTEXT_WARN_BYTES:
        print(f"harness: always-loaded context ({' + '.join(CONTEXT_FILES)}) is "
              f"{total} bytes, over {CONTEXT_WARN_BYTES}; move area-only context "
              "into a scoped file beside its code.")


def report_local():
    """Flag unresolved merge conflicts and unset config values."""
    report_context_size()
    base_files = [f.relative_to(BASE) for f in BASE.rglob("*") if f.is_file()]
    conflicted = [str(p) for p in base_files if "<<<<<<< local" in (read(p) or "")]
    if conflicted:
        print(f"harness: unresolved merge conflicts in {', '.join(conflicted)}; "
              "resolve them with the operator.")
        return
    labels = unset_values()
    if labels:
        print(f"harness: {CONFIG_FILE} has unset values; ask the operator "
              f"for them before other work and record the answers: {', '.join(labels)}.")


def gh_cached(name, args, keep=None, ttl=CHECK_CACHE_SECONDS):
    """JSON from `gh`, cached per repo for `ttl` seconds (0 = no cache); None on failure.
    With `keep`, only answers it accepts are cached or served from cache."""
    key = hashlib.sha1(str(Path.cwd().resolve()).encode()).hexdigest()[:12]
    cache = CACHE / f"{name}-{key}.json"
    if ttl and cache.exists() and time.time() - cache.stat().st_mtime < ttl:
        data = json.loads(cache.read_text())
        if keep is None or keep(data):
            return data
    r = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=15)
    if r.returncode:
        return None
    data = json.loads(r.stdout)
    if (keep is None or keep(data)) and ttl:
        write(cache, r.stdout)
    return data


def report_ci_gate():
    """An `auto` merge policy is only safe if the default branch requires CI checks."""
    if not re.search(r"Merge policy:\*\*\s*`auto`", read(Path(CONFIG_FILE)) or ""):
        return
    try:
        # Only a positive answer is cached: "no required checks" is re-asked every run.
        rules = gh_cached("branch-rules", ["api", "repos/{owner}/{repo}/rules/branches/"
                                           + default_branch()],
                          keep=lambda rs: any(r["type"] == "required_status_checks" for r in rs))
    except Exception:
        rules = None
    if rules is None:
        print("harness: merge policy is `auto` but required CI checks on the default "
              "branch could not be verified; treat merges as `on-request` until they are.")
    elif not any(r["type"] == "required_status_checks" for r in rules):
        print("harness: merge policy is `auto` but the default branch requires no CI "
              "checks; treat merges as `on-request` and ask the operator to require CI.")


def default_branch():
    r = subprocess.run(["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"],
                       capture_output=True, text=True)
    return r.stdout.strip().removeprefix("origin/") or "main"


def maintenance_issue():
    """Tracking issue's labels and body via gh, never cached: an audit's status edit must show now."""
    m = re.search(r"Maintenance tracking issue:\*\*\s*(?:[\w.-]+/[\w.-]+)?#(\d+)",
                  read(Path(CONFIG_FILE)) or "")
    if not m:
        return None
    return gh_cached("maintenance", ["issue", "view", m.group(1), "--json",
                                     "number,body,labels"], ttl=0)


def report_maintenance():
    """Nag for each list in docs/MAINTENANCE.md whose interval has passed."""
    lists = re.findall(r"^## (\w+)\b.*?(\d+) or more days ago", read(MAINTENANCE_FILE) or "", re.M)
    try:
        issue = maintenance_issue()
    except Exception:
        issue = None
    if not lists or not issue:
        return
    if any("audit" in lbl["name"] for lbl in issue["labels"]):
        return  # claimed by a running audit
    log = subprocess.run(["git", "log", "--reverse", "--format=%as", "--", str(STATE)],
                         capture_output=True, text=True).stdout
    installed = re.match(r"\d{4}-\d{2}-\d{2}", log)  # first commit of .harness/
    for name, days in lists:
        # "Last completed:" is the pre-v19 single-audit field; it still counts for any list.
        last = (re.search(rf"{name} last completed:\**\s*(\S+)", issue["body"], re.I)
                or re.search(r"Last completed:\**\s*(\S+)", issue["body"]))
        date = (re.match(r"\d{4}-\d{2}-\d{2}", last.group(1)) if last else None) or installed
        if date and (datetime.date.today()
                     - datetime.date.fromisoformat(date.group(0))).days < int(days):
            continue
        extra = ""
        if name.lower() == "weekly":
            try:
                opened = gh_cached("open-issues", ["issue", "list", "--state", "open",
                                                   "--limit", "1000", "--json", "number"])
                extra = f", {len(opened)} open issues" if opened is not None else ""
            except Exception:
                pass
        print(f"harness: {name.lower()} maintenance due (last completed: "
              f"{last.group(1) if last else 'unknown'}{extra}); follow {MAINTENANCE_FILE} "
              f"and record results in #{issue['number']}.")


def report_unindexed(created):
    """Docs pages the harness just created need a link in the docs index."""
    index = read(Path("docs/README.md"))
    for p in created:
        if index is not None and p.startswith("docs/") and Path(p).name not in index:
            print(f"link {p} from docs/README.md")


def cmd_check():
    if not STATE.is_dir():
        # Checkout predates the harness (or is on a stale branch) while origin has it.
        ref = f"origin/{default_branch()}"
        r = subprocess.run(["git", "cat-file", "-e", f"{ref}:{BASE}"], capture_output=True)
        if r.returncode == 0:
            print(f"harness: this checkout lacks the harness that {ref} has, so its "
                  "rules are not loaded. Tell the operator before other work, and move to "
                  f"a branch or worktree based on an up-to-date {ref}.")
        return
    try:
        upstream = fetch(CHECK_CACHE_SECONDS)
    except Exception:
        upstream = None  # offline: stay quiet about the harness, still check config
    if upstream:
        files = changed(upstream) + [f"{p} (removed from harness)" for p in removed(upstream)]
        if files:
            print(f"harness: harness changed ({versions()}; see CHANGELOG.md in "
                  f"the harness repo): {', '.join(files)}. Run "
                  "`harness diff`, summarize the changes for the operator, and "
                  "run `harness apply` only after they approve.")
    report_local()
    report_ci_gate()
    report_maintenance()


def cmd_diff():
    upstream = fetch()
    files = changed(upstream)
    if files:
        print(f"harness {versions()}")
    for p in files:
        old = read(BASE / p) or ""
        sys.stdout.writelines(difflib.unified_diff(
            old.splitlines(True), upstream[p].splitlines(True),
            f"a/{p} (last applied)", f"b/{p} (harness now)"))
    for p in removed(upstream):
        print(f"{p}: removed from the harness; delete it by hand if no longer wanted.")
    if not files:
        print("harness: up to date.")


def merge(local, base, new):
    """3-way merge; returns (text, conflict_count)."""
    with tempfile.TemporaryDirectory() as d:
        paths = []
        for name, text in (("local", local), ("base", base), ("new", new)):
            f = Path(d) / name
            f.write_text(text)
            paths.append(str(f))
        r = subprocess.run(["git", "merge-file", "-p", "-L", "local", "-L",
                            "last-applied", "-L", "harness", *paths],
                           capture_output=True, text=True)
        if r.returncode < 0:
            sys.exit(f"git merge-file failed: {r.stderr}")
        return r.stdout, r.returncode


def cmd_apply(only):
    upstream = fetch()
    files = [p for p in changed(upstream) if not only or p in only]
    created = [p for p in files if read(Path(p)) is None]
    for p in files:
        local, base = read(Path(p)), read(BASE / p)
        if local is None or local == base:
            write(Path(p), upstream[p])
            print(f"updated {p}")
        else:
            text, conflicts = merge(local, base or "", upstream[p])
            write(Path(p), text)
            print(f"merged {p}" + (f" with {conflicts} conflict(s); resolve the "
                                   "markers by hand" if conflicts else ""))
        write(BASE / p, upstream[p])
    if not only or not changed(upstream):
        write(APPLIED, upstream_version() + "\n")
    if not files:
        print("harness: nothing to apply.")
    report_unindexed(created)
    report_local()
    if any("<<<<<<< local" in (read(Path(p)) or "") for p in upstream):
        sys.exit(1)  # stop callers (commit/merge chains) until conflicts are resolved


def cmd_init():
    upstream = fetch()
    created = []
    for p, text in upstream.items():
        local = read(Path(p))
        if local is None:
            write(Path(p), text)
            created.append(p)
            print(f"created {p}")
        elif local != text:
            print(f"{p} already exists: merge the harness version from "
                  f"{BASE / p} into it by hand, removing anything it duplicates.")
        write(BASE / p, text)
    write(APPLIED, upstream_version() + "\n")
    claude = Path("CLAUDE.md")
    if not claude.exists():
        write(claude, "@AGENTS.md\n")
        print("created CLAUDE.md (imports AGENTS.md for Claude Code)")
    elif "@AGENTS.md" not in claude.read_text():
        print("CLAUDE.md exists: add an `@AGENTS.md` line so Claude Code loads the rules.")
    report_unindexed(created)
    report_local()


AUDIT_SIGNALS = (
    ("spawns a subagent", lambda name, blob: name in ("Task", "Agent", "spawn_agent")),
    ("touches PROJECT_CONFIG.md", lambda name, blob: "PROJECT_CONFIG" in blob),
    ("uses a worktree", lambda name, blob: "worktree" in (name + blob).lower()),
    ("creates an issue", lambda name, blob: "gh issue create" in blob),
    ("creates a PR", lambda name, blob: "gh pr create" in blob),
    ("reads language rules", lambda name, blob: "docs/languages/" in blob),
)


def tool_calls(line):
    """(tool name, searchable input) per tool call on one session-log line.

    Only tool calls count: session prose contains the injected AGENTS.md
    text, so matching raw logs would report every rule as always followed.
    """
    if '"tool_use"' not in line and "_call" not in line:
        return []
    try:
        obj = json.loads(line)
    except Exception:
        return []
    if not isinstance(obj, dict):
        return []
    calls = []
    message = obj.get("message")
    content = message.get("content") if isinstance(message, dict) else None
    for block in content or []:  # Claude Code
        if isinstance(block, dict) and block.get("type") == "tool_use":
            calls.append((block.get("name", ""), json.dumps(block.get("input", {}))))
    payload = obj.get("payload")  # Codex
    if isinstance(payload, dict) and str(payload.get("type", "")).endswith("_call"):
        calls.append((payload.get("name", ""),
                      str(payload.get("input") or payload.get("arguments")
                          or payload.get("action") or "")))
    return calls


def audit_session(path):
    fired = set()
    try:
        with open(path, errors="ignore") as f:
            for line in f:
                for name, blob in tool_calls(line):
                    fired.update(label for label, test in AUDIT_SIGNALS if test(name, blob))
                if len(fired) == len(AUDIT_SIGNALS):
                    break
    except OSError:
        pass
    return fired


def session_cwd(path):
    try:
        with open(path, errors="ignore") as f:
            for line in f:
                if '"cwd"' in line:
                    try:
                        obj = json.loads(line)
                    except Exception:
                        continue
                    if not isinstance(obj, dict):
                        continue
                    payload = obj.get("payload")
                    cwd = obj.get("cwd") or (payload.get("cwd") if isinstance(payload, dict) else None)
                    if cwd:
                        return cwd
    except OSError:
        pass
    return ""


def cmd_audit(limit):
    """Report how often harness behaviors fired in recent local sessions.

    Operator-run only: nothing here is added to `check`, so measurement
    costs no context in agent sessions.
    """
    cwd = str(Path.cwd().resolve())
    home = Path.home()
    in_repo = lambda p: p == cwd or p.startswith(cwd + "/")
    recent = lambda files: sorted(files, key=os.path.getmtime, reverse=True)
    slug = re.sub(r"[^A-Za-z0-9]", "-", cwd)
    claude = [f for d in (home / ".claude" / "projects").glob(slug + "*")
              for f in d.glob("*.jsonl") if in_repo(session_cwd(f))]
    codex = []
    for f in recent((home / ".codex" / "sessions").rglob("*.jsonl")):
        if in_repo(session_cwd(f)):
            codex.append(f)
            if len(codex) >= limit:  # newest first; bound the scan of other repos
                break
    version = (read(APPLIED) or "?").strip()
    print(f"harness audit: {cwd} (applied harness v{version})")
    found = False
    for source, files in (("Claude Code", claude), ("Codex", codex)):
        files = recent(files)[:limit]
        if not files:
            continue
        found = True
        counts = {label: 0 for label, _ in AUDIT_SIGNALS}
        for f in files:
            for label in audit_session(f):
                counts[label] += 1
        newest = datetime.date.fromtimestamp(os.path.getmtime(files[0]))
        oldest = datetime.date.fromtimestamp(os.path.getmtime(files[-1]))
        print(f"\n{source}: {len(files)} most recent sessions ({oldest} to {newest})")
        for label, n in counts.items():
            print(f"  {n:>3}/{len(files)}  {label}")
    if not found:
        print("no local Claude Code or Codex sessions found for this repo.")


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "check"
    try:
        if cmd == "check":
            cmd_check()
        elif cmd == "diff":
            cmd_diff()
        elif cmd == "apply":
            cmd_apply(set(args[1:]))
        elif cmd == "init":
            cmd_init()
        elif cmd == "audit":
            cmd_audit(max(1, int(args[1])) if len(args) > 1 and args[1].isdigit() else 15)
        else:
            sys.exit(__doc__)
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as e:
        detail = e.stderr.decode() if isinstance(e.stderr, bytes) else e.stderr or ""
        detail = detail.strip()
        sys.exit(f"harness: `{' '.join(map(str, e.cmd))}` failed"
                 f"{': ' + detail if detail else ''}. Check the network and retry; "
                 f"if it persists, delete {CLONE} to re-clone.")


if __name__ == "__main__":
    main()
