@@ -0,0 +1,114 @@
+// @ts-check
+const { test, expect } = require("@playwright/test");
+const path = require("path");
+const { pathToFileURL } = require("url");
+
+const APP = pathToFileURL(path.join(__dirname, "..", "index.html")).href;
+
+test.beforeEach(async ({ context }) => {
+  // The app is fully offline; fail on any unexpected network call.
+  await context.route(/^(?!file:)/, (route) => {
+    throw new Error(`Unexpected network request: ${route.request().url()}`);
+  });
+});
+
+async function add(page, text) {
+  await page.getByLabel("New task").fill(text);
+  await page.getByRole("button", { name: "Add" }).click();
+}
+
+const items = (page) => page.locator("#list li span");
+const filter = (page, name) => page.getByRole("button", { name, exact: true });
+
+test("add, toggle, delete, and reload keep working", async ({ page }) => {
+  await page.goto(APP);
+  await add(page, "Milk");
+  await add(page, "Bread");
+  await add(page, "  ");
+  await expect(items(page)).toHaveText(["Milk", "Bread"]);
+
+  await page.getByLabel("Complete Milk").check();
+  await page.getByRole("button", { name: "Delete Bread" }).click();
+  await expect(items(page)).toHaveText(["Milk"]);
+
+  await page.reload();
+  await expect(items(page)).toHaveText(["Milk"]);
+  await expect(page.getByLabel("Complete Milk")).toBeChecked();
+});
+
+test("previously saved tasks load unchanged", async ({ page }) => {
+  const saved = [
+    { id: 1, text: "Old open", done: false },
+    { id: 2, text: "Old done", done: true },
+  ];
+  await page.goto(APP);
+  await page.evaluate((s) => localStorage.setItem("todos", JSON.stringify(s)), saved);
+  await page.reload();
+  await expect(items(page)).toHaveText(["Old open", "Old done"]);
+
+  // Switching filters is view-only and must not rewrite storage.
+  await filter(page, "Completed").click();
+  await filter(page, "Active").click();
+  const stored = await page.evaluate(() => JSON.parse(localStorage.getItem("todos")));
+  expect(stored).toEqual(saved);
+});
+
+test("filters show All, Active, and Completed tasks", async ({ page }) => {
+  await page.goto(APP);
+  await add(page, "A");
+  await add(page, "B");
+  await add(page, "C");
+  await page.getByLabel("Complete B").check();
+
+  await expect(filter(page, "All")).toHaveAttribute("aria-pressed", "true");
+  await expect(items(page)).toHaveText(["A", "B", "C"]);
+
+  await filter(page, "Active").click();
+  await expect(filter(page, "Active")).toHaveAttribute("aria-pressed", "true");
+  await expect(filter(page, "All")).toHaveAttribute("aria-pressed", "false");
+  await expect(items(page)).toHaveText(["A", "C"]);
+
+  await filter(page, "Completed").click();
+  await expect(items(page)).toHaveText(["B"]);
+
+  await filter(page, "All").click();
+  await expect(items(page)).toHaveText(["A", "B", "C"]);
+});
+
+test("filtered views update after toggle, add, and delete", async ({ page }) => {
+  await page.goto(APP);
+  await add(page, "A");
+  await add(page, "B");
+
+  await filter(page, "Active").click();
+  // click, not check(): the row leaves the filtered view once toggled.
+  await page.getByLabel("Complete A").click();
+  await expect(items(page)).toHaveText(["B"]);
+
+  await add(page, "C");
+  await expect(items(page)).toHaveText(["B", "C"]);
+
+  await filter(page, "Completed").click();
+  await expect(items(page)).toHaveText(["A"]);
+  await page.getByLabel("Complete A").click();
+  await expect(items(page)).toHaveCount(0);
+
+  await add(page, "D"); // new tasks are active, so hidden here
+  await expect(items(page)).toHaveCount(0);
+
+  await filter(page, "Active").click();
+  await page.getByRole("button", { name: "Delete B" }).click();
+  await expect(items(page)).toHaveText(["A", "C", "D"]);
+
+  await filter(page, "All").click();
+  await expect(items(page)).toHaveText(["A", "C", "D"]);
+});
+
+test("screenshot", async ({ page }, info) => {
+  await page.goto(APP);
+  await add(page, "Buy groceries");
+  await add(page, "Call the plumber about the kitchen sink");
+  await page.getByLabel("Complete Buy groceries").check();
+  await filter(page, "Active").click();
+  await page.screenshot({ path: info.outputPath("todo.png") });
+});
