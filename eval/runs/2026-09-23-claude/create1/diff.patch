@@ -0,0 +1,20 @@
+// Minimal static server for tests; the app itself needs no server.
+import { createServer } from "node:http";
+import { readFile } from "node:fs/promises";
+import { extname, join, normalize } from "node:path";
+
+const root = new URL("../src/", import.meta.url).pathname;
+const types = { ".html": "text/html", ".js": "text/javascript" };
+const port = Number(process.env.PORT ?? 4173);
+
+createServer(async (req, res) => {
+  const path = normalize(new URL(req.url, "http://x").pathname).replace(/^(\.\.[/\\])+/, "");
+  const file = join(root, path === "/" ? "index.html" : path);
+  if (!file.startsWith(root)) return res.writeHead(403).end();
+  try {
+    const body = await readFile(file);
+    res.writeHead(200, { "content-type": types[extname(file)] ?? "application/octet-stream" }).end(body);
+  } catch {
+    res.writeHead(404).end();
+  }
+}).listen(port, "127.0.0.1");
diff --git a/tests/todo.spec.mjs b/tests/todo.spec.mjs
new file mode 100644
index 0000000..0e6764f
--- /dev/null
+++ b/tests/todo.spec.mjs
@@ -0,0 +1,158 @@
+import { test, expect } from "@playwright/test";
+
+const STORAGE_KEY = "todo.tasks.v1";
+
+// Per-test problems; each worker runs one test at a time.
+let problems;
+
+test.beforeEach(async ({ page, baseURL }) => {
+  problems = [];
+  // The app is offline-only: block and record any request that leaves the test server.
+  await page.route("**/*", (route) => {
+    if (route.request().url().startsWith(baseURL)) return route.continue();
+    problems.push(`external request: ${route.request().url()}`);
+    return route.abort();
+  });
+  page.on("pageerror", (e) => problems.push(`page error: ${e.message}`));
+  await page.goto("/");
+});
+
+test.afterEach(() => {
+  expect(problems).toEqual([]);
+});
+
+const input = (page) => page.getByLabel("New task");
+const items = (page) => page.getByRole("listitem");
+
+async function add(page, text) {
+  await input(page).fill(text);
+  await page.getByRole("button", { name: "Add" }).click();
+}
+
+async function stored(page) {
+  return page.evaluate((k) => JSON.parse(localStorage.getItem(k) ?? "null"), STORAGE_KEY);
+}
+
+test("adds a nonblank task, trimmed, and clears the input", async ({ page }) => {
+  await add(page, "  Buy milk  ");
+  await expect(items(page)).toHaveCount(1);
+  await expect(items(page)).toHaveText(/^Buy milk/);
+  await expect(input(page)).toHaveValue("");
+  expect(await stored(page)).toMatchObject([{ text: "Buy milk", done: false }]);
+});
+
+test("adds with the Enter key", async ({ page }) => {
+  await input(page).fill("Walk dog");
+  await input(page).press("Enter");
+  await expect(items(page)).toHaveCount(1);
+});
+
+for (const blank of ["", "   ", "\t \t"]) {
+  test(`rejects blank input ${JSON.stringify(blank)}`, async ({ page }) => {
+    await add(page, blank);
+    await expect(items(page)).toHaveCount(0);
+    await expect(page.getByRole("alert")).toHaveText("Enter a task.");
+    expect(await stored(page)).toBeNull();
+    // Error clears after a valid add.
+    await add(page, "Real task");
+    await expect(page.locator("#error")).toBeEmpty();
+    await expect(page.locator("#error")).toBeHidden();
+  });
+}
+
+test("marks a task complete and incomplete, persisted", async ({ page }) => {
+  await add(page, "Pay rent");
+  const box = page.getByRole("checkbox", { name: "Pay rent" });
+  await box.check();
+  await expect(items(page).first()).toHaveClass(/done/);
+  expect(await stored(page)).toMatchObject([{ done: true }]);
+  await page.reload();
+  await expect(page.getByRole("checkbox", { name: "Pay rent" })).toBeChecked();
+  await page.getByRole("checkbox", { name: "Pay rent" }).uncheck();
+  await expect(items(page).first()).not.toHaveClass(/done/);
+  await page.reload();
+  await expect(page.getByRole("checkbox", { name: "Pay rent" })).not.toBeChecked();
+});
+
+test("deletes only the chosen task, persisted", async ({ page }) => {
+  await add(page, "One");
+  await add(page, "Two");
+  await add(page, "Three");
+  await page.getByRole("button", { name: 'Delete "Two"' }).click();
+  await expect(items(page)).toHaveCount(2);
+  await page.reload();
+  await expect(items(page).locator(".text")).toHaveText(["One", "Three"]);
+});
+
+test("preserves tasks and order across reloads", async ({ page }) => {
+  await add(page, "First");
+  await add(page, "Second");
+  await page.getByRole("checkbox", { name: "Second" }).check();
+  await page.reload();
+  await expect(items(page).locator(".text")).toHaveText(["First", "Second"]);
+  await expect(page.getByRole("checkbox", { name: "First" })).not.toBeChecked();
+  await expect(page.getByRole("checkbox", { name: "Second" })).toBeChecked();
+});
+
+test("renders task text as text, not HTML", async ({ page }) => {
+  await add(page, '<img src=x onerror="window.pwned=1">');
+  await expect(items(page).locator(".text")).toHaveText('<img src=x onerror="window.pwned=1">');
+  expect(await page.evaluate(() => window.pwned)).toBeUndefined();
+});
+
+for (const [name, raw] of [
+  ["invalid JSON", "{not json"],
+  ["non-array JSON", '{"a":1}'],
+  ["malformed entries", '[null, {"id":"a","text":"  "}, {"id":"b","text":"ok","done":"yes"}]'],
+]) {
+  test(`recovers from ${name} in storage`, async ({ page }) => {
+    await page.evaluate(([k, v]) => localStorage.setItem(k, v), [STORAGE_KEY, raw]);
+    await page.reload();
+    await add(page, "Still works");
+    await expect(items(page).last()).toHaveText(/Still works/);
+  });
+}
+
+test("moves focus to the next task (or the input) after delete", async ({ page }) => {
+  await add(page, "One");
+  await add(page, "Two");
+  await page.getByRole("button", { name: 'Delete "One"' }).click();
+  await expect(page.getByRole("button", { name: 'Delete "Two"' })).toBeFocused();
+  await page.getByRole("button", { name: 'Delete "Two"' }).click();
+  await expect(input(page)).toBeFocused();
+});
+
+test("storage write failure shows an error and changes nothing", async ({ page }) => {
+  await add(page, "Keep me");
+  await page.evaluate(() => {
+    Storage.prototype.setItem = () => {
+      throw new DOMException("full", "QuotaExceededError");
+    };
+  });
+  const error = page.getByRole("alert");
+
+  await add(page, "Unsaved");
+  await expect(error).toContainText("Couldn't save");
+  await expect(items(page)).toHaveCount(1);
+  await expect(input(page)).toHaveValue("Unsaved");
+
+  await page.getByRole("checkbox", { name: "Keep me" }).click();
+  await expect(page.getByRole("checkbox", { name: "Keep me" })).not.toBeChecked();
+
+  await page.getByRole("button", { name: 'Delete "Keep me"' }).click();
+  await expect(items(page)).toHaveCount(1);
+
+  await page.reload();
+  await expect(items(page).locator(".text")).toHaveText(["Keep me"]);
+  await expect(page.getByRole("checkbox", { name: "Keep me" })).not.toBeChecked();
+});
+
+test("screenshot", async ({ page }, info) => {
+  await add(page, "Buy milk");
+  await add(page, "A much longer task description that should wrap cleanly on narrow screens without overflow");
+  await add(page, "Done thing");
+  await page.getByRole("checkbox", { name: "Done thing" }).check();
+  await page.screenshot({ path: info.outputPath(`${info.project.name}.png`), fullPage: true });
+  const overflow = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);
+  expect(overflow).toBe(false);
+});
