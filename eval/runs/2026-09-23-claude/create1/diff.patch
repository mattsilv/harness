+import { test, expect } from "@playwright/test";
+
+// The stack promises no server: the page must work when opened from disk.
+test("works when opened from file://", async ({ page }) => {
+  const problems = [];
+  page.on("pageerror", (e) => problems.push(e.message));
+  page.on("console", (m) => m.type() === "error" && problems.push(m.text()));
+  const url = new URL("../src/index.html", import.meta.url).href;
+  expect(url.startsWith("file://")).toBe(true);
+  await page.goto(url);
+  await page.getByLabel("New task").fill("From disk");
+  await page.getByRole("button", { name: "Add" }).click();
+  await page.reload();
+  await expect(page.getByRole("listitem")).toHaveText(/From disk/);
+  expect(problems).toEqual([]);
+});
