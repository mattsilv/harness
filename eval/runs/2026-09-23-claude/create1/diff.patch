+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>To-do</title>
+  <style>
+    :root {
+      --color-text: #1f2328;
+      --color-muted: #656d76;
+      --color-border: #d0d7de;
+      --color-accent: #0969da;
+      --color-danger: #cf222e;
+      --color-bg: #ffffff;
+      --font: system-ui, -apple-system, "Segoe UI", sans-serif;
+      --space: 0.5rem;
+      --radius: 6px;
+      --tap: 44px;
+    }
+    * { box-sizing: border-box; }
+    body { margin: 0; font: 16px/1.4 var(--font); color: var(--color-text); background: var(--color-bg); }
+    main { max-width: 36rem; margin: 0 auto; padding: calc(var(--space) * 2); }
+    h1 { font-size: 1.5rem; margin: 0 0 var(--space); }
+    form { display: flex; gap: var(--space); }
+    input[type="text"] { flex: 1; min-width: 0; min-height: var(--tap); padding: 0 var(--space); font: inherit; border: 1px solid var(--color-border); border-radius: var(--radius); }
+    button { min-height: var(--tap); padding: 0 calc(var(--space) * 2); font: inherit; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-bg); cursor: pointer; }
+    button[type="submit"] { background: var(--color-accent); border-color: var(--color-accent); color: #fff; }
+    .error { color: var(--color-danger); margin: var(--space) 0 0; font-size: 0.875rem; }
+    .error:empty { display: none; }
+    ul { list-style: none; margin: var(--space) 0 0; padding: 0; }
+    li { display: flex; align-items: center; gap: var(--space); padding: calc(var(--space) / 2) 0; border-bottom: 1px solid var(--color-border); min-height: var(--tap); }
+    li label { flex: 1; display: flex; align-items: center; gap: var(--space); min-height: var(--tap); overflow-wrap: anywhere; cursor: pointer; }
+    li input[type="checkbox"] { width: 1.25rem; height: 1.25rem; flex: none; }
+    li.done .text { text-decoration: line-through; color: var(--color-muted); }
+    li button { color: var(--color-danger); }
+    .empty { color: var(--color-muted); padding: var(--space) 0; }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>To-do</h1>
+    <form id="add-form" novalidate>
+      <input id="new-task" type="text" aria-label="New task" placeholder="What needs doing?" autocomplete="off" maxlength="500">
+      <button type="submit">Add</button>
+    </form>
+    <p id="error" class="error" role="alert"></p>
+    <ul id="tasks" aria-label="Tasks"></ul>
+    <p id="empty" class="empty">No tasks yet.</p>
+  </main>
+  <script src="app.js"></script>
