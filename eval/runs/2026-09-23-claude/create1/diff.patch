--- /dev/null
+++ b/src/app.js
@@ -0,0 +1,98 @@
+// Classic script (not a module) so the page works when opened from file://.
+// Loaded at the end of <body>, so the elements below already exist.
+(() => {
+  const STORAGE_KEY = "todo.tasks.v1";
+
+  const form = document.getElementById("add-form");
+  const input = document.getElementById("new-task");
+  const error = document.getElementById("error");
+  const list = document.getElementById("tasks");
+  const empty = document.getElementById("empty");
+
+  function load() {
+    try {
+      const data = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]");
+      if (!Array.isArray(data)) return [];
+      return data
+        .filter((t) => t && typeof t.id === "string" && typeof t.text === "string" && t.text.trim() !== "")
+        .map((t) => ({ id: t.id, text: t.text.trim(), done: t.done === true }));
+    } catch {
+      // Corrupt or unreadable storage: start empty rather than crash.
+      return [];
+    }
+  }
+
+  let tasks = load();
+
+  // Save first, then adopt the new state, so the UI never shows unsaved changes.
+  function commit(next) {
+    try {
+      localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
+    } catch {
+      error.textContent = "Couldn't save: browser storage is full or unavailable. Change not applied.";
+      render();
+      return false;
+    }
+    tasks = next;
+    error.textContent = "";
+    render();
+    return true;
+  }
+
+  function newId() {
+    return crypto.randomUUID?.() ?? `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
+  }
+
+  function render() {
+    list.replaceChildren(
+      ...tasks.map((task) => {
+        const li = document.createElement("li");
+        li.dataset.id = task.id;
+        li.classList.toggle("done", task.done);
+
+        const label = document.createElement("label");
+        const checkbox = document.createElement("input");
+        checkbox.type = "checkbox";
+        checkbox.checked = task.done;
+        checkbox.addEventListener("change", () => {
+          commit(tasks.map((t) => (t.id === task.id ? { ...t, done: checkbox.checked } : t)));
+          list.querySelector(`li[data-id="${CSS.escape(task.id)}"] input`)?.focus();
+        });
+        const text = document.createElement("span");
+        text.className = "text";
+        text.textContent = task.text;
+        label.append(checkbox, text);
+
+        const del = document.createElement("button");
+        del.type = "button";
+        del.textContent = "Delete";
+        del.setAttribute("aria-label", `Delete "${task.text}"`);
+        del.addEventListener("click", () => {
+          const index = tasks.findIndex((t) => t.id === task.id);
+          if (!commit(tasks.filter((t) => t.id !== task.id))) return;
+          // Keep keyboard users in place: focus the next task's delete button, else the previous, else the input.
+          const buttons = list.querySelectorAll("button");
+          (buttons[Math.min(index, buttons.length - 1)] ?? input).focus();
+        });
+
+        li.append(label, del);
+        return li;
+      }),
+    );
+    empty.hidden = tasks.length > 0;
+  }
+
+  form.addEventListener("submit", (event) => {
+    event.preventDefault();
+    const text = input.value.trim();
+    if (text === "") {
+      error.textContent = "Enter a task.";
+      input.focus();
+      return;
+    }
+    if (commit([...tasks, { id: newId(), text, done: false }])) input.value = "";
+    input.focus();
+  });
+
+  render();
+})();
