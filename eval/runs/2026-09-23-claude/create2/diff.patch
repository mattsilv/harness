+// @ts-check
+const fs = require("node:fs");
+const path = require("node:path");
+const { test, expect } = require("@playwright/test");
+
+// Serve the static files from disk under a fixed origin; abort any other request.
+const ORIGIN = "http://localhost:4173";
+const ROOT = path.resolve(__dirname, "..");
+const TYPES = { ".html": "text/html", ".js": "text/javascript" };
+
+test.beforeEach(async ({ page }) => {
+  await page.route("**/*", async (route) => {
+    const url = new URL(route.request().url());
+    if (url.origin !== ORIGIN) return route.abort();
+    const file = path.join(ROOT, url.pathname === "/" ? "index.html" : url.pathname);
+    if (!file.startsWith(ROOT) || !fs.existsSync(file)) return route.fulfill({ status: 404 });
+    return route.fulfill({ body: fs.readFileSync(file), contentType: TYPES[path.extname(file)] });
+  });
+  await page.goto(ORIGIN + "/");
+});
+
+const input = (page) => page.getByRole("textbox", { name: "New task" });
+const items = (page) => page.getByRole("list", { name: "Tasks" }).getByRole("listitem");
+
+async function add(page, text) {
+  await input(page).fill(text);
+  await page.getByRole("button", { name: "Add" }).click();
+}
+
+test("adds a trimmed task and clears the input", async ({ page }) => {
+  await add(page, "  Buy milk  ");
+  await expect(items(page)).toHaveText(["Buy milkDelete"]);
+  await expect(input(page)).toHaveValue("");
+});
+
+test("rejects blank tasks", async ({ page }) => {
+  await add(page, "");
+  await add(page, "   \t ");
+  await expect(items(page)).toHaveCount(0);
+  await expect(page.getByRole("alert")).toHaveText("Enter a task.");
+  await page.reload();
+  await expect(items(page)).toHaveCount(0);
+});
+
+test("marks a task complete and incomplete", async ({ page }) => {
+  await add(page, "Walk dog");
+  const box = page.getByRole("checkbox", { name: "Walk dog" });
+  await box.check();
+  await expect(box).toBeChecked();
+  await expect(items(page).first()).toHaveClass("done");
+  await box.uncheck();
+  await expect(box).not.toBeChecked();
+  await expect(items(page).first()).not.toHaveClass("done");
+});
+
+test("deletes only the chosen task", async ({ page }) => {
+  await add(page, "Keep");
+  await add(page, "Remove");
+  await page.getByRole("button", { name: 'Delete "Remove"' }).click();
+  await expect(items(page)).toHaveCount(1);
+  await expect(page.getByRole("checkbox", { name: "Keep" })).toBeVisible();
+});
+
+test("deletes the right one of two tasks with identical text", async ({ page }) => {
+  await add(page, "Milk");
+  await add(page, "Milk");
+  await items(page).nth(0).getByRole("checkbox").check();
+  await items(page).nth(1).getByRole("button", { name: /Delete/ }).click();
+  await page.reload();
+  await expect(items(page)).toHaveCount(1);
+  await expect(items(page).first().getByRole("checkbox")).toBeChecked();
+});
+
+test("preserves tasks, completion, and deletion across reloads", async ({ page }) => {
+  await add(page, "One");
+  await add(page, "Two");
+  await add(page, "Three");
+  await page.getByRole("checkbox", { name: "Two" }).check();
+  await page.getByRole("button", { name: 'Delete "Three"' }).click();
+
+  await page.reload();
+  await expect(items(page)).toHaveCount(2);
+  await expect(page.getByRole("checkbox", { name: "One" })).not.toBeChecked();
+  await expect(page.getByRole("checkbox", { name: "Two" })).toBeChecked();
+
+  await page.getByRole("checkbox", { name: "Two" }).uncheck();
+  await page.reload();
+  await expect(page.getByRole("checkbox", { name: "Two" })).not.toBeChecked();
+});
+
+test("renders task text as text, not HTML", async ({ page }) => {
+  await add(page, "<img src=x onerror=alert(1)>");
+  await expect(page.getByRole("checkbox", { name: "<img src=x onerror=alert(1)>" })).toBeVisible();
+  await expect(page.locator("li img")).toHaveCount(0);
+});
+
+test("recovers from corrupt stored data", async ({ page }) => {
+  await page.evaluate(() => localStorage.setItem("todo.tasks.v1", "{not json"));
+  await page.reload();
+  await expect(items(page)).toHaveCount(0);
+  await add(page, "Fresh start");
+  await page.reload();
+  await expect(items(page)).toHaveCount(1);
+});
