+"use strict";
+
+const STORAGE_KEY = "todo.tasks.v1";
+
+function loadTasks() {
+  try {
+    const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]");
+    if (!Array.isArray(parsed)) return [];
+    return parsed.filter(
+      (t) => t && typeof t.id === "string" && typeof t.text === "string" && typeof t.done === "boolean"
+    );
+  } catch {
+    return [];
+  }
+}
+
+// crypto.randomUUID is only available in secure contexts; fall back elsewhere.
+function newId() {
+  return crypto.randomUUID?.() ?? `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
+}
+
+function saveTasks(tasks) {
+  localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks));
+}
+
+let tasks = loadTasks();
+
+const form = document.getElementById("add-form");
+const input = document.getElementById("new-task");
+const list = document.getElementById("list");
+const error = document.getElementById("error");
+const empty = document.getElementById("empty");
+
+function update(next) {
+  tasks = next;
+  saveTasks(tasks);
+  render();
+}
+
+function render() {
+  list.replaceChildren(
+    ...tasks.map((task) => {
+      const li = document.createElement("li");
+      li.className = task.done ? "done" : "";
+
+      const label = document.createElement("label");
+      const checkbox = document.createElement("input");
+      checkbox.type = "checkbox";
+      checkbox.checked = task.done;
+      checkbox.addEventListener("change", () =>
+        update(tasks.map((t) => (t.id === task.id ? { ...t, done: checkbox.checked } : t)))
+      );
+      const text = document.createElement("span");
+      text.textContent = task.text;
+      label.append(checkbox, text);
+
+      const del = document.createElement("button");
+      del.type = "button";
+      del.className = "delete";
+      del.textContent = "Delete";
+      del.setAttribute("aria-label", `Delete "${task.text}"`);
+      del.addEventListener("click", () => update(tasks.filter((t) => t.id !== task.id)));
+
+      li.append(label, del);
+      return li;
+    })
+  );
+  empty.hidden = tasks.length > 0;
+}
+
+form.addEventListener("submit", (event) => {
+  event.preventDefault();
+  const text = input.value.trim();
+  if (!text) {
+    error.textContent = "Enter a task.";
+    input.focus();
+    return;
+  }
+  error.textContent = "";
+  update([...tasks, { id: newId(), text, done: false }]);
+  input.value = "";
+  input.focus();
+});
+
+render();
