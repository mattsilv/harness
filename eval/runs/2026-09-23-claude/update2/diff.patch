diff --git a/tests/todo.spec.js b/tests/todo.spec.js
new file mode 100644
index 0000000..fe389a0
--- /dev/null
+++ b/tests/todo.spec.js
@@ -0,0 +1,108 @@
+// @ts-check
+const fs = require("node:fs");
+const path = require("node:path");
+const { test, expect } = require("@playwright/test");
+
+// Serve index.html from a fake origin so localStorage behaves as in production,
+// and abort every other request so tests never touch the network.
+const ORIGIN = "http://todo.test";
+const html = fs.readFileSync(path.join(__dirname, "..", "index.html"), "utf8");
+
+test.beforeEach(async ({ context }) => {
+  await context.route("**/*", (route) =>
+    route.request().url() === `${ORIGIN}/`
+      ? route.fulfill({ contentType: "text/html", body: html })
+      : route.abort()
+  );
+});
+
+const items = (page) => page.locator("#list li span");
+const filter = (page, name) => page.getByRole("button", { name, exact: true });
+const saved = (page) => page.evaluate(() => JSON.parse(localStorage.getItem("todos") || "[]"));
+
+async function add(page, text) {
+  await page.getByLabel("New task").fill(text);
+  await page.getByRole("button", { name: "Add" }).click();
+}
+
+test("add, toggle, delete, and reload persist tasks", async ({ page }) => {
+  await page.goto(ORIGIN);
+  await add(page, "Buy milk");
+  await add(page, "Walk dog");
+  await add(page, "   ");
+  await expect(items(page)).toHaveText(["Buy milk", "Walk dog"]);
+
+  await page.getByLabel("Complete Buy milk").check();
+  await page.getByRole("button", { name: "Delete Walk dog" }).click();
+  await expect(items(page)).toHaveText(["Buy milk"]);
+
+  await page.reload();
+  await expect(items(page)).toHaveText(["Buy milk"]);
+  await expect(page.getByLabel("Complete Buy milk")).toBeChecked();
+  expect(await saved(page)).toEqual([expect.objectContaining({ text: "Buy milk", done: true })]);
+});
+
+test("tasks saved before filters existed load unchanged", async ({ page }) => {
+  const legacy = [
+    { id: 1, text: "Old open", done: false },
+    { id: 2, text: "Old done", done: true },
+  ];
+  await page.goto(ORIGIN);
+  await page.evaluate((v) => localStorage.setItem("todos", v), JSON.stringify(legacy));
+  await page.reload();
+
+  await expect(items(page)).toHaveText(["Old open", "Old done"]);
+  await expect(filter(page, "All")).toHaveAttribute("aria-pressed", "true");
+  await filter(page, "Completed").click();
+  await expect(items(page)).toHaveText(["Old done"]);
+  // Filtering is view-only and must not rewrite stored tasks.
+  expect(await saved(page)).toEqual(legacy);
+});
+
+test("All, Active, and Completed show the matching tasks", async ({ page }) => {
+  await page.goto(ORIGIN);
+  for (const t of ["A", "B", "C"]) await add(page, t);
+  await page.getByLabel("Complete B").check();
+
+  await filter(page, "Active").click();
+  await expect(items(page)).toHaveText(["A", "C"]);
+  await expect(filter(page, "Active")).toHaveAttribute("aria-pressed", "true");
+  await expect(filter(page, "All")).toHaveAttribute("aria-pressed", "false");
+
+  await filter(page, "Completed").click();
+  await expect(items(page)).toHaveText(["B"]);
+
+  await filter(page, "All").click();
+  await expect(items(page)).toHaveText(["A", "B", "C"]);
+});
+
+test("actions under a filter update the view and storage", async ({ page }) => {
+  await page.goto(ORIGIN);
+  for (const t of ["A", "B"]) await add(page, t);
+
+  // Completing a task in Active hides it; adding in Completed keeps it hidden.
+  // click(), not check(): the checkbox leaves the view before check() can confirm it.
+  await filter(page, "Active").click();
+  await page.getByLabel("Complete A").click();
+  await expect(items(page)).toHaveText(["B"]);
+  await filter(page, "Completed").click();
+  await add(page, "C");
+  await expect(items(page)).toHaveText(["A"]);
+
+  // Un-completing in Completed hides it; deleting there removes it from storage.
+  await page.getByLabel("Complete A").click();
+  await expect(items(page)).toHaveCount(0);
+  await filter(page, "Active").click();
+  await expect(items(page)).toHaveText(["A", "B", "C"]);
+  await page.getByRole("button", { name: "Delete B" }).click();
+  await expect(items(page)).toHaveText(["A", "C"]);
+
+  expect((await saved(page)).map((t) => [t.text, t.done])).toEqual([["A", false], ["C", false]]);
+});
+
+test("screenshot", async ({ page }, info) => {
+  await page.goto(ORIGIN);
+  for (const t of ["Buy milk", "Walk dog"]) await add(page, t);
+  await page.getByLabel("Complete Buy milk").check();
+  await page.screenshot({ path: info.outputPath("todo.png") });
+});
