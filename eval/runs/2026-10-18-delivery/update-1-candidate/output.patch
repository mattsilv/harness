diff --git a/tests/todo.test.js b/tests/todo.test.js
new file mode 100644
index 0000000..c1d4fa0
--- /dev/null
+++ b/tests/todo.test.js
@@ -0,0 +1,108 @@
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const test = require("node:test");
+const vm = require("node:vm");
+
+const html = fs.readFileSync(path.join(__dirname, "..", "index.html"), "utf8");
+const appScript = html.match(/<script>([\s\S]*?)<\/script>/)[1];
+
+class Element {
+  constructor(dataset = {}) {
+    this.dataset = dataset;
+    this.attributes = {};
+    this.children = [];
+    this.value = "";
+    this.checked = false;
+  }
+
+  setAttribute(name, value) {
+    this.attributes[name] = value;
+  }
+
+  append(...children) {
+    this.children.push(...children);
+  }
+
+  replaceChildren(...children) {
+    this.children = children;
+  }
+
+  click() {
+    this.onclick?.();
+  }
+}
+
+function startApp(saved = null) {
+  const storage = new Map(saved ? [["todos", saved]] : []);
+  const elements = {
+    add: new Element(),
+    text: new Element(),
+    list: new Element(),
+  };
+  const filters = ["all", "active", "completed"].map(
+    (filter) => new Element({ filter }),
+  );
+  const document = {
+    getElementById: (id) => elements[id],
+    querySelectorAll: (selector) => selector === "[data-filter]" ? filters : [],
+    createElement: () => new Element(),
+  };
+  const localStorage = {
+    getItem: (key) => storage.get(key) ?? null,
+    setItem: (key, value) => storage.set(key, value),
+  };
+
+  vm.runInNewContext(appScript, { document, localStorage });
+  return { elements, filters, storage };
+}
+
+function taskTexts(app) {
+  return app.elements.list.children.map((item) => item.children[2].textContent);
+}
+
+function addTask(app, text) {
+  app.elements.text.value = text;
+  app.elements.add.onsubmit({ preventDefault() {} });
+}
+
+test("All, Active, and Completed filters show the matching saved tasks", () => {
+  const app = startApp(JSON.stringify([
+    { id: 1, text: "Active task", done: false },
+    { id: 2, text: "Completed task", done: true },
+  ]));
+
+  assert.deepEqual(taskTexts(app), ["Active task", "Completed task"]);
+  app.filters[1].click();
+  assert.deepEqual(taskTexts(app), ["Active task"]);
+  assert.equal(app.filters[1].attributes["aria-pressed"], "true");
+  app.filters[2].click();
+  assert.deepEqual(taskTexts(app), ["Completed task"]);
+  app.filters[0].click();
+  assert.deepEqual(taskTexts(app), ["Active task", "Completed task"]);
+  assert.equal(app.storage.get("todos"), JSON.stringify([
+    { id: 1, text: "Active task", done: false },
+    { id: 2, text: "Completed task", done: true },
+  ]));
+});
+
+test("adding, toggling, deleting, and reloading tasks still work", () => {
+  const app = startApp();
+  addTask(app, "  Keep this task  ");
+  assert.deepEqual(taskTexts(app), ["Keep this task"]);
+  assert.equal(app.elements.text.value, "");
+
+  const checkbox = app.elements.list.children[0].children[0];
+  checkbox.checked = true;
+  checkbox.onchange();
+  app.filters[1].click();
+  assert.deepEqual(taskTexts(app), []);
+  app.filters[2].click();
+  assert.deepEqual(taskTexts(app), ["Keep this task"]);
+
+  const reloaded = startApp(app.storage.get("todos"));
+  assert.deepEqual(taskTexts(reloaded), ["Keep this task"]);
+  reloaded.elements.list.children[0].children[4].click();
+  assert.deepEqual(taskTexts(reloaded), []);
+  assert.equal(JSON.parse(reloaded.storage.get("todos")).length, 0);
+});
