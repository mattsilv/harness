diff --git a/app.js b/app.js
new file mode 100644
index 0000000..beaab69
--- /dev/null
+++ b/app.js
@@ -0,0 +1,94 @@
+const STORAGE_KEY = "simple-todo.tasks.v1";
+
+function loadTasks(storage) {
+  try {
+    const value = JSON.parse(storage.getItem(STORAGE_KEY) ?? "[]");
+    if (!Array.isArray(value)) return [];
+    return value.filter((task) => task && typeof task.id === "string" && typeof task.text === "string" && typeof task.completed === "boolean");
+  } catch {
+    return [];
+  }
+}
+
+function saveTasks(storage, tasks) {
+  storage.setItem(STORAGE_KEY, JSON.stringify(tasks));
+}
+
+function addTask(tasks, text, id = globalThis.crypto.randomUUID()) {
+  const cleanText = text.trim();
+  if (!cleanText) return tasks;
+  return [...tasks, { id, text: cleanText, completed: false }];
+}
+
+function toggleTask(tasks, id) {
+  return tasks.map((task) => task.id === id ? { ...task, completed: !task.completed } : task);
+}
+
+function deleteTask(tasks, id) {
+  return tasks.filter((task) => task.id !== id);
+}
+
+if (typeof document !== "undefined") {
+  const storage = window.localStorage;
+  const form = document.querySelector("#task-form");
+  const input = document.querySelector("#task-input");
+  const list = document.querySelector("#task-list");
+  const count = document.querySelector("#task-count");
+  const emptyState = document.querySelector("#empty-state");
+  let tasks = loadTasks(storage);
+
+  function update(nextTasks) {
+    tasks = nextTasks;
+    saveTasks(storage, tasks);
+    render();
+  }
+
+  function render() {
+    list.replaceChildren();
+    for (const task of tasks) {
+      const row = document.createElement("li");
+      row.className = `task-row${task.completed ? " completed" : ""}`;
+      const toggle = document.createElement("button");
+      toggle.className = "task-toggle";
+      toggle.type = "button";
+      toggle.setAttribute("aria-label", `${task.completed ? "Mark incomplete" : "Mark complete"}: ${task.text}`);
+      toggle.setAttribute("aria-pressed", String(task.completed));
+      toggle.textContent = task.completed ? "✓" : "";
+      toggle.addEventListener("click", () => update(toggleTask(tasks, task.id)));
+      const name = document.createElement("span");
+      name.className = "task-name";
+      name.textContent = task.text;
+      const remove = document.createElement("button");
+      remove.className = "delete-task";
+      remove.type = "button";
+      remove.textContent = "Delete";
+      remove.setAttribute("aria-label", `Delete: ${task.text}`);
+      remove.addEventListener("click", () => update(deleteTask(tasks, task.id)));
+      row.append(toggle, name, remove);
+      list.append(row);
+    }
+    const remaining = tasks.filter((task) => !task.completed).length;
+    count.textContent = `${remaining} ${remaining === 1 ? "task" : "tasks"} left`;
+    emptyState.hidden = tasks.length > 0;
+  }
+
+  form.addEventListener("submit", (event) => {
+    event.preventDefault();
+    const nextTasks = addTask(tasks, input.value);
+    if (nextTasks === tasks) {
+      input.setCustomValidity("Enter a task before adding it.");
+      input.reportValidity();
+      return;
+    }
+    input.setCustomValidity("");
+    update(nextTasks);
+    form.reset();
+    input.focus();
+  });
+  input.addEventListener("input", () => input.setCustomValidity(""));
+  render();
+}
+
+if (typeof window !== "undefined") {
+  window.Todo = { STORAGE_KEY, loadTasks, saveTasks, addTask, toggleTask, deleteTask };
+}
diff --git a/index.html b/index.html
new file mode 100644
