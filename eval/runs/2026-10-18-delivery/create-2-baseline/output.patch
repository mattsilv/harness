+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f4f6f8">
+  <title>To-do</title>
+  <style>
+    :root { color-scheme: light; font: 16px/1.5 system-ui, sans-serif; color: #182230; background: #f4f6f8; }
+    * { box-sizing: border-box; }
+    body { margin: 0; padding: 3rem 1rem; }
+    main { width: min(100%, 34rem); margin: 0 auto; padding: 2rem; background: white; border: 1px solid #d9e0e8; border-radius: 1rem; box-shadow: 0 0.5rem 2rem #1822300d; }
+    h1 { margin: 0 0 1.25rem; font-size: 1.75rem; }
+    form { display: flex; gap: 0.5rem; }
+    input { flex: 1; min-width: 0; padding: 0.7rem 0.8rem; border: 1px solid #aab6c4; border-radius: 0.5rem; font: inherit; }
+    button { padding: 0.65rem 0.9rem; border: 0; border-radius: 0.5rem; background: #2457c5; color: white; font: inherit; cursor: pointer; }
+    button:focus-visible, input:focus-visible { outline: 3px solid #92b4ff; outline-offset: 2px; }
+    ul { display: grid; gap: 0.65rem; padding: 0; margin: 1.5rem 0 0; list-style: none; }
+    li { display: flex; align-items: center; gap: 0.65rem; padding: 0.65rem; border: 1px solid #e0e5eb; border-radius: 0.5rem; }
+    li span { flex: 1; overflow-wrap: anywhere; }
+    li.completed span { color: #647184; text-decoration: line-through; }
+    .delete { background: #eef1f5; color: #263447; }
+    #empty { margin: 1.5rem 0 0; color: #647184; }
+    @media (max-width: 30rem) { body { padding: 1rem 0.65rem; } main { padding: 1.25rem; } }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>To-do</h1>
+    <form id="task-form">
+      <label for="task-input" hidden>New task</label>
+      <input id="task-input" name="task" type="text" placeholder="Add a task" required>
+      <button type="submit">Add</button>
+    </form>
+    <p id="empty">No tasks yet.</p>
+    <ul id="tasks" aria-label="Tasks"></ul>
+  </main>
+  <script src="app.js" defer></script>
+</body>
+</html>
