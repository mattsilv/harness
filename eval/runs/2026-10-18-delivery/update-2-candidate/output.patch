diff --git a/scripts/test-filters.mjs b/scripts/test-filters.mjs
new file mode 100755
index 0000000..a242469
--- /dev/null
+++ b/scripts/test-filters.mjs
@@ -0,0 +1,78 @@
+#!/usr/bin/env node
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import vm from "node:vm";
+
+const html = await readFile(new URL("../index.html", import.meta.url), "utf8");
+const script = html.match(/<script>([\s\S]*?)<\/script>/)?.[1];
+assert.ok(script, "app script exists");
+
+class Element {
+  constructor(dataset = {}) {
+    this.dataset = dataset;
+    this.children = [];
+    this.attributes = {};
+    this.value = "";
+    this.textContent = "";
+  }
+  append(...items) { this.children.push(...items); }
+  replaceChildren(...items) { this.children = items; }
+  setAttribute(name, value) { this.attributes[name] = value; }
+}
+
+function launch(storage) {
+  const filters = ["all", "active", "completed"].map((filter) => new Element({ filter }));
+  const elements = { add: new Element(), text: new Element(), list: new Element() };
+  const context = {
+    document: {
+      getElementById: (id) => elements[id],
+      querySelectorAll: () => filters,
+      createElement: () => new Element(),
+    },
+    localStorage: storage,
+    Date,
+  };
+  vm.runInNewContext(script, context);
+  return { elements, filters };
+}
+
+const values = new Map();
+const storage = {
+  getItem: (key) => values.get(key) ?? null,
+  setItem: (key, value) => values.set(key, value),
+};
+let app = launch(storage);
+assert.deepEqual(app.elements.list.children, [], "starts with an empty list");
+
+function add(text) {
+  app.elements.text.value = text;
+  app.elements.add.onsubmit({ preventDefault() {} });
+}
+function show(filter) {
+  app.filters.find((button) => button.dataset.filter === filter).onclick();
+}
+function visibleText() {
+  return app.elements.list.children.map((li) => li.children[2].textContent);
+}
+
+add("Write checks");
+add("Ship filters");
+assert.deepEqual(visibleText(), ["Write checks", "Ship filters"], "All shows every task");
+app.elements.list.children[0].children[0].checked = true;
+app.elements.list.children[0].children[0].onchange();
+show("active");
+assert.deepEqual(visibleText(), ["Ship filters"], "Active hides completed tasks");
+assert.equal(app.filters[1].attributes["aria-pressed"], "true", "selected filter is announced");
+show("completed");
+assert.deepEqual(visibleText(), ["Write checks"], "Completed hides active tasks");
+show("all");
+assert.deepEqual(visibleText(), ["Write checks", "Ship filters"], "All restores every task");
+
+// Filter changes do not alter saved data, and a fresh page load restores both tasks.
+app = launch(storage);
+assert.deepEqual(visibleText(), ["Write checks", "Ship filters"], "reload preserves tasks and completion");
+show("active");
+app.elements.list.children[0].children[4].onclick();
+assert.deepEqual(JSON.parse(storage.getItem("todos")).map((task) => task.text), ["Write checks"], "delete persists");
+
+console.log("Task filters, add, toggle, delete, persistence, and reload checks passed.");
