--- /dev/null
+++ b/app.js
@@ -0,0 +1,123 @@
+(function () {
+  'use strict';
+
+  const STORAGE_KEY = 'today-tasks-v1';
+
+  function readTasks(storage) {
+    try {
+      const value = JSON.parse(storage.getItem(STORAGE_KEY) || '[]');
+      if (!Array.isArray(value)) return [];
+      return value.filter((task) => task && typeof task.id === 'string' &&
+        typeof task.text === 'string' && task.text.trim() && typeof task.completed === 'boolean');
+    } catch (_) {
+      return [];
+    }
+  }
+
+  function writeTasks(storage, tasks) {
+    storage.setItem(STORAGE_KEY, JSON.stringify(tasks));
+  }
+
+  function createTodoList(storage, makeId) {
+    let tasks = readTasks(storage);
+    return {
+      all: () => tasks.slice(),
+      add(text) {
+        const cleanText = String(text).trim();
+        if (!cleanText) return null;
+        const task = { id: makeId(), text: cleanText, completed: false };
+        tasks = [...tasks, task];
+        writeTasks(storage, tasks);
+        return task;
+      },
+      toggle(id) {
+        let changed = false;
+        tasks = tasks.map((task) => {
+          if (task.id !== id) return task;
+          changed = true;
+          return { ...task, completed: !task.completed };
+        });
+        if (changed) writeTasks(storage, tasks);
+        return changed;
+      },
+      remove(id) {
+        const next = tasks.filter((task) => task.id !== id);
+        if (next.length === tasks.length) return false;
+        tasks = next;
+        writeTasks(storage, tasks);
+        return true;
+      }
+    };
+  }
+
+  if (typeof module !== 'undefined' && module.exports) {
+    module.exports = { STORAGE_KEY, createTodoList };
+    return;
+  }
+
+  const byId = (id) => document.getElementById(id);
+  const listElement = byId('task-list');
+  const emptyElement = byId('empty-state');
+  const countElement = byId('task-count');
+  const form = byId('task-form');
+  const input = byId('task-input');
+  let nextId = 0;
+  const todoList = createTodoList(window.localStorage, () => {
+    nextId += 1;
+    return `${Date.now().toString(36)}-${nextId.toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
+  });
+
+  function icon(path) {
+    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+    svg.setAttribute('viewBox', '0 0 24 24');
+    svg.setAttribute('fill', 'none');
+    svg.setAttribute('stroke', 'currentColor');
+    svg.setAttribute('stroke-width', '2');
+    svg.setAttribute('stroke-linecap', 'round');
+    svg.setAttribute('stroke-linejoin', 'round');
+    const shape = document.createElementNS('http://www.w3.org/2000/svg', 'path');
+    shape.setAttribute('d', path);
+    svg.append(shape);
+    return svg;
+  }
+
+  function render() {
+    const tasks = todoList.all();
+    listElement.replaceChildren();
+    emptyElement.hidden = tasks.length > 0;
+    countElement.textContent = `${tasks.length} ${tasks.length === 1 ? 'task' : 'tasks'}`;
+    tasks.forEach((task) => {
+      const row = document.createElement('li');
+      row.className = `task-row${task.completed ? ' is-complete' : ''}`;
+      const check = document.createElement('button');
+      check.type = 'button';
+      check.className = 'task-check';
+      check.setAttribute('aria-label', `${task.completed ? 'Mark incomplete' : 'Mark complete'}: ${task.text}`);
+      check.setAttribute('aria-pressed', String(task.completed));
+      if (task.completed) check.append(icon('M5 12l4 4L19 6'));
+      check.addEventListener('click', () => { todoList.toggle(task.id); render(); });
+
+      const text = document.createElement('span');
+      text.className = 'task-text';
+      text.textContent = task.text;
+      const remove = document.createElement('button');
+      remove.type = 'button';
+      remove.className = 'delete-button';
+      remove.setAttribute('aria-label', `Delete: ${task.text}`);
+      remove.append(icon('M3 6h18M8 6V4h8v2m3 0l-1 14H6L5 6m4 4v6m6-6v6'));
+      remove.addEventListener('click', () => { todoList.remove(task.id); render(); });
+
+      row.append(check, text, remove);
+      listElement.append(row);
+    });
+  }
+
+  form.addEventListener('submit', (event) => {
+    event.preventDefault();
+    if (!todoList.add(input.value)) return;
+    input.value = '';
+    render();
+    input.focus();
+  });
+  render();
+})();
