+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <meta name="theme-color" content="#f7f5f0">
+  <title>Today — To-do list</title>
+  <link rel="stylesheet" href="styles.css">
+  <script src="app.js" defer></script>
+</head>
+<body>
+  <main class="app" aria-labelledby="page-title">
+    <header class="page-header">
+      <p class="eyebrow">A little at a time</p>
+      <h1 id="page-title">Today<span class="period">.</span></h1>
+      <p class="intro">Make room for what matters.</p>
+    </header>
+
+    <form id="task-form" class="task-form">
+      <label class="visually-hidden" for="task-input">Add a task</label>
+      <input id="task-input" name="task" type="text" placeholder="What needs doing?" autocomplete="off" required>
+      <button class="add-button" type="submit" aria-label="Add task"><span aria-hidden="true">+</span></button>
+    </form>
+
+    <section class="list-section" aria-labelledby="list-heading">
+      <div class="list-heading-row">
+        <h2 id="list-heading">Your list</h2>
+        <span id="task-count" class="task-count" aria-live="polite"></span>
+      </div>
+      <ul id="task-list" class="task-list" aria-label="Tasks"></ul>
+      <p id="empty-state" class="empty-state">Nothing on your list yet. Add a task above.</p>
+    </section>
+    <p class="save-note"><span aria-hidden="true">↳</span> Your list stays on this device.</p>
+  </main>
+</body>
+</html>
