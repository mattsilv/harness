+:root {
+  color-scheme: light;
+  --ink: #252822;
+  --muted: #85877e;
+  --accent: #52705a;
+  --accent-dark: #3d5945;
+  --paper: #f7f5f0;
+  --surface: #fffefa;
+  --line: #e9e6de;
+  --soft-green: #e9eee7;
+  --danger: #9f5146;
+  font-family: 'DM Sans', sans-serif;
+}
+
+* { box-sizing: border-box; }
+
+body {
+  min-width: 320px;
+  min-height: 100vh;
+  margin: 0;
+  padding: 56px 20px 40px;
+  color: var(--ink);
+  background: radial-gradient(ellipse at 50% 0%, #eeeee5 0, var(--paper) 54%, #f5f2eb 100%);
+}
+
+.app { width: min(100%, 520px); margin: 0 auto; }
+.page-header { margin: 0 0 38px; text-align: center; }
+.eyebrow { margin: 0 0 11px; color: var(--accent); font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
+h1 { margin: 0; font-family: 'Playfair Display', Georgia, serif; font-size: clamp(54px, 12vw, 72px); font-weight: 600; letter-spacing: -.06em; line-height: 1; }
+.period { color: var(--accent); }
+.intro { margin: 13px 0 0; color: var(--muted); font-size: 15px; }
+
+.task-form { display: flex; gap: 10px; padding: 8px; border: 1px solid #e8e6df; border-radius: 17px; background: var(--surface); box-shadow: 0 8px 25px #3835220a; }
+.task-form input { min-width: 0; flex: 1; padding: 11px 12px; border: 0; outline: 0; color: var(--ink); background: transparent; font: inherit; font-size: 15px; }
+.task-form input::placeholder { color: #a7a79e; }
+.task-form:focus-within { border-color: #8fa08e; box-shadow: 0 0 0 3px #52705a1b; }
+.add-button { display: grid; width: 43px; height: 43px; flex: 0 0 43px; place-items: center; border: 0; border-radius: 12px; color: white; background: var(--accent); cursor: pointer; font: inherit; transition: background .15s ease, transform .15s ease; }
+.add-button span { margin-top: -2px; font-size: 27px; font-weight: 400; line-height: 1; }
+.add-button:hover { background: var(--accent-dark); transform: translateY(-1px); }
+.add-button:focus-visible, .task-check:focus-visible, .delete-button:focus-visible { outline: 3px solid #95ae98; outline-offset: 2px; }
+
+.list-section { margin-top: 37px; }
+.list-heading-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
+h2 { margin: 0; font-size: 14px; font-weight: 700; letter-spacing: .01em; }
+.task-count { color: var(--muted); font-size: 12px; }
+.task-list { display: grid; gap: 9px; margin: 0; padding: 0; list-style: none; }
+.task-row { display: flex; min-height: 61px; align-items: center; gap: 12px; padding: 10px 12px 10px 15px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); box-shadow: 0 3px 10px #38352208; animation: arrive .18s ease-out; }
+.task-check { display: grid; width: 23px; height: 23px; flex: 0 0 23px; place-items: center; border: 1.5px solid #c9cbc1; border-radius: 8px; color: white; background: transparent; cursor: pointer; }
+.task-check[aria-pressed="true"] { border-color: var(--accent); background: var(--accent); }
+.task-check svg { width: 14px; height: 14px; }
+.task-text { min-width: 0; flex: 1; overflow-wrap: anywhere; font-size: 14px; line-height: 1.45; }
+.task-row.is-complete .task-text { color: #9c9d96; text-decoration: line-through; text-decoration-color: #adb2a9; }
+.delete-button { display: grid; width: 35px; height: 35px; flex: 0 0 35px; place-items: center; border: 0; border-radius: 10px; color: #a4a59c; background: transparent; cursor: pointer; }
+.delete-button:hover { color: var(--danger); background: #f8eeeb; }
+.delete-button svg { width: 17px; height: 17px; }
+.empty-state { margin: 0; padding: 22px 12px; border: 1px dashed #deddd5; border-radius: 14px; color: var(--muted); text-align: center; font-size: 13px; }
+.save-note { margin: 22px 0 0; color: #96978f; text-align: center; font-size: 11px; }
+.save-note span { margin-right: 4px; color: var(--accent); }
+.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; clip-path: inset(50%); }
+
+@keyframes arrive { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
+@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; } }
+@media (max-width: 480px) { body { padding: 40px 19px 32px; } .page-header { margin-bottom: 30px; } .list-section { margin-top: 31px; } }
