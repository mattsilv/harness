@@ -0,0 +1,55 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createTodoList, STORAGE_KEY } = require('../app.js');
+
+function memoryStorage(initial = null) {
+  const values = new Map(initial === null ? [] : [[STORAGE_KEY, initial]]);
+  return {
+    getItem: (key) => values.has(key) ? values.get(key) : null,
+    setItem: (key, value) => values.set(key, value)
+  };
+}
+
+test('adds trimmed nonblank tasks and rejects blank input', () => {
+  const list = createTodoList(memoryStorage(), () => 'task-1');
+  assert.equal(list.add('  \n  '), null);
+  assert.deepEqual(list.all(), []);
+  assert.deepEqual(list.add('  Pick up bread  '), { id: 'task-1', text: 'Pick up bread', completed: false });
+});
+
+test('toggles a task complete and incomplete', () => {
+  const list = createTodoList(memoryStorage(), () => 'task-1');
+  list.add('Read');
+  assert.equal(list.toggle('task-1'), true);
+  assert.equal(list.all()[0].completed, true);
+  assert.equal(list.toggle('task-1'), true);
+  assert.equal(list.all()[0].completed, false);
+  assert.equal(list.toggle('missing'), false);
+});
+
+test('deletes a task from the list and saved data', () => {
+  const storage = memoryStorage();
+  const list = createTodoList(storage, () => 'task-1');
+  list.add('Recycle');
+  assert.equal(list.remove('task-1'), true);
+  assert.deepEqual(list.all(), []);
+  assert.deepEqual(JSON.parse(storage.getItem(STORAGE_KEY)), []);
+  assert.equal(list.remove('missing'), false);
+});
+
+test('restores saved tasks after creating a new list from storage', () => {
+  const storage = memoryStorage();
+  const firstVisit = createTodoList(storage, () => 'task-1');
+  firstVisit.add('Call home');
+  firstVisit.toggle('task-1');
+  const afterReload = createTodoList(storage, () => 'task-2');
+  assert.deepEqual(afterReload.all(), [{ id: 'task-1', text: 'Call home', completed: true }]);
+});
+
+test('ignores corrupt saved data and malformed task entries', () => {
+  assert.deepEqual(createTodoList(memoryStorage('{'), () => 'unused').all(), []);
+  const malformed = JSON.stringify([{ id: 4, text: 'Bad', completed: false }, { id: 'ok', text: 'Good', completed: false }]);
+  assert.deepEqual(createTodoList(memoryStorage(malformed), () => 'unused').all(), [{ id: 'ok', text: 'Good', completed: false }]);
+});
