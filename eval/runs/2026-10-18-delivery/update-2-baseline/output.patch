diff --git a/scripts/check-filters.mjs b/scripts/check-filters.mjs
new file mode 100755
index 0000000..6ebd8c2
--- /dev/null
+++ b/scripts/check-filters.mjs
@@ -0,0 +1,83 @@
+#!/usr/bin/env node
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import vm from "node:vm";
+
+const html = await readFile(new URL("../index.html", import.meta.url), "utf8");
+const appScript = html.match(/<script>([\s\S]*?)<\/script>/)?.[1];
+assert.ok(appScript, "the app script exists");
+
+class Element {
+  children = [];
+  attributes = {};
+  value = "";
+  checked = false;
+
+  setAttribute(name, value) { this.attributes[name] = value; }
+  append(...children) { this.children.push(...children); }
+  replaceChildren(...children) { this.children = children; }
+}
+
+const storage = new Map([["todos", JSON.stringify([
+  { id: 1, text: "buy milk", done: false },
+  { id: 2, text: "write docs", done: true },
+])]]);
+
+function startApp() {
+  const ids = ["list", "text", "add", "filter-all", "filter-active", "filter-completed"];
+  const elements = Object.fromEntries(ids.map((id) => [id, new Element()]));
+  const context = {
+    document: {
+      getElementById: (id) => elements[id],
+      createElement: (tagName) => Object.assign(new Element(), { tagName }),
+    },
+    localStorage: {
+      getItem: (key) => storage.get(key) ?? null,
+      setItem: (key, value) => storage.set(key, value),
+    },
+    Date,
+  };
+  vm.runInNewContext(appScript, context);
+  return elements;
+}
+
+const initial = startApp();
+assert.deepEqual(initial.list.children.map((row) => row.children[2].textContent), ["buy milk", "write docs"]);
+
+initial["filter-active"].onclick();
+assert.deepEqual(initial.list.children.map((row) => row.children[2].textContent), ["buy milk"]);
+assert.equal(initial["filter-active"].attributes["aria-pressed"], "true");
+
+initial["filter-completed"].onclick();
+assert.deepEqual(initial.list.children.map((row) => row.children[2].textContent), ["write docs"]);
+assert.equal(initial["filter-active"].attributes["aria-pressed"], "false");
+assert.equal(initial["filter-completed"].attributes["aria-pressed"], "true");
+
+initial["filter-active"].onclick();
+const checkbox = initial.list.children[0].children[0];
+checkbox.checked = true;
+checkbox.onchange();
+assert.deepEqual(initial.list.children, [], "completing a task removes it from Active");
+assert.deepEqual(JSON.parse(storage.get("todos")), [
+  { id: 1, text: "buy milk", done: true },
+  { id: 2, text: "write docs", done: true },
+]);
+
+initial.text.value = "  plan trip  ";
+initial.add.onsubmit({ preventDefault() {} });
+assert.equal(initial.text.value, "");
+assert.deepEqual(initial.list.children.map((row) => row.children[2].textContent), ["plan trip"], "adding an active task keeps the Active filter");
+
+initial["filter-all"].onclick();
+assert.deepEqual(initial.list.children.map((row) => row.children[2].textContent), ["buy milk", "write docs", "plan trip"]);
+initial.list.children[2].children[4].onclick();
+assert.deepEqual(initial.list.children.map((row) => row.children[2].textContent), ["buy milk", "write docs"]);
+
+const reloaded = startApp();
+assert.deepEqual(reloaded.list.children.map((row) => row.children[2].textContent), ["buy milk", "write docs"]);
+assert.deepEqual(JSON.parse(storage.get("todos")), [
+  { id: 1, text: "buy milk", done: true },
+  { id: 2, text: "write docs", done: true },
+]);
+
+console.log("Passed: All, Active, Completed, pressed state, toggle, add, delete, saved task shape, and reload.");
