diff --git a/test/filters.test.js b/test/filters.test.js
new file mode 100644
index 0000000..12496e7
--- /dev/null
+++ b/test/filters.test.js
@@ -0,0 +1,70 @@
+const { test } = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const { filterTodos } = require("../filters.js");
+
+function sample() {
+  return [
+    { id: 1, text: "write", done: false },
+    { id: 2, text: "ship", done: true },
+    { id: 3, text: "review", done: false },
+  ];
+}
+
+test("all returns every task in order", () => {
+  assert.deepEqual(
+    filterTodos(sample(), "all").map((t) => t.id),
+    [1, 2, 3],
+  );
+});
+
+test("active returns only incomplete tasks", () => {
+  assert.deepEqual(
+    filterTodos(sample(), "active").map((t) => t.id),
+    [1, 3],
+  );
+});
+
+test("completed returns only complete tasks", () => {
+  assert.deepEqual(
+    filterTodos(sample(), "completed").map((t) => t.id),
+    [2],
+  );
+});
+
+test("unknown filter falls back to all", () => {
+  assert.equal(filterTodos(sample(), "bogus").length, 3);
+});
+
+test("empty list returns empty for every filter", () => {
+  for (const f of ["all", "active", "completed"]) {
+    assert.deepEqual(filterTodos([], f), []);
+  }
+});
+
+test("does not mutate the stored task list", () => {
+  const todos = sample();
+  filterTodos(todos, "completed");
+  assert.equal(todos.length, 3);
+  assert.deepEqual(todos.map((t) => t.id), [1, 2, 3]);
+});
+
+test("returns the same task objects so toggle and delete keep working", () => {
+  const todos = sample();
+  const active = filterTodos(todos, "active");
+  active[0].done = true;
+  assert.equal(todos[0].done, true);
+});
+
+test("page exposes All, Active, Completed and loads the shared filter logic", () => {
+  const html = fs.readFileSync(
+    path.join(__dirname, "..", "index.html"),
+    "utf8",
+  );
+  assert.match(html, /<script src="filters\.js"><\/script>/);
+  for (const value of ["all", "active", "completed"]) {
+    assert.match(html, new RegExp(`data-filter="${value}"`));
+  }
+  assert.match(html, /filterTodos\(todos, filter\)/);
+});
