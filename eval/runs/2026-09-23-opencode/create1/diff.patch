+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1" />
+  <title>To-Do</title>
+  <style>
+    :root { --fg: #1a1a1a; --muted: #666; --border: #ddd; --accent: #0b5fff; --danger: #b00020; }
+    * { box-sizing: border-box; }
+    body {
+      margin: 0;
+      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+      color: var(--fg);
+      background: #fafafa;
+    }
+    main { max-width: 32rem; margin: 2rem auto; padding: 0 1rem; }
+    h1 { font-size: 1.5rem; margin: 0 0 1rem; }
+    form { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; }
+    #todo-input {
+      flex: 1;
+      padding: 0.6rem 0.75rem;
+      font-size: 1rem;
+      border: 1px solid var(--border);
+      border-radius: 0.5rem;
+    }
+    form button {
+      padding: 0.6rem 1rem;
+      font-size: 1rem;
+      border: 0;
+      border-radius: 0.5rem;
+      background: var(--accent);
+      color: #fff;
+      cursor: pointer;
+    }
+    #todo-status { min-height: 1.25rem; margin: 0 0 0.5rem; color: var(--danger); font-size: 0.875rem; }
+    ul { list-style: none; margin: 0; padding: 0; }
+    li {
+      display: flex;
+      align-items: center;
+      gap: 0.75rem;
+      padding: 0.6rem 0.25rem;
+      border-bottom: 1px solid var(--border);
+    }
+    li .text { flex: 1; overflow-wrap: anywhere; }
+    li.completed .text { color: var(--muted); text-decoration: line-through; }
+    li input[type="checkbox"] { width: 1.15rem; height: 1.15rem; }
+    li .delete {
+      border: 0;
+      background: transparent;
+      color: var(--danger);
+      font-size: 1rem;
+      padding: 0.25rem 0.5rem;
+      border-radius: 0.35rem;
+      cursor: pointer;
+    }
+    li .delete:hover { background: #f2dede; }
+    li.empty { color: var(--muted); }
+  </style>
+</head>
+<body>
+  <main>
+    <h1>To-Do</h1>
+    <form id="todo-form" novalidate>
+      <input
+        id="todo-input"
+        name="task"
+        type="text"
+        autocomplete="off"
+        placeholder="Add a task"
+        aria-label="New task"
+      />
+      <button type="submit">Add</button>
+    </form>
+    <p id="todo-status" role="alert" aria-live="polite"></p>
+    <ul id="todo-list"></ul>
+  </main>
+  <script type="module" src="./app.js"></script>
+</body>
+</html>
