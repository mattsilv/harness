+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { JSDOM } from "jsdom";
+
+import { initTodoApp, STORAGE_KEY } from "../app.js";
+
+const HTML = readFileSync(new URL("../index.html", import.meta.url), "utf8");
+const ORIGIN = "https://todo.test/";
+
+// Mount the real index.html markup, seed localStorage, and wire the real app.js.
+function mount(seed = {}) {
+  const jsdom = new JSDOM(HTML, { url: ORIGIN });
+  const { window } = jsdom;
+  for (const [key, value] of Object.entries(seed)) window.localStorage.setItem(key, value);
+  const store = initTodoApp({ document: window.document, storage: window.localStorage });
+  return { jsdom, window, document: window.document, store };
+}
+
+// A reload keeps localStorage but rebuilds the DOM, so carry the storage snapshot over.
+function reload(app) {
+  const snapshot = {};
+  for (let i = 0; i < app.window.localStorage.length; i += 1) {
+    const key = app.window.localStorage.key(i);
+    snapshot[key] = app.window.localStorage.getItem(key);
+  }
+  return mount(snapshot);
+}
+
+function visibleTasks(app) {
+  return [...app.document.querySelectorAll("#todo-list li[data-task-id]")].map((item) => ({
+    id: item.dataset.taskId,
+    text: item.querySelector(".text").textContent,
+    completed: item.classList.contains("completed"),
+    checked: item.querySelector('input[type="checkbox"]').checked,
+  }));
+}
+
+function addTask(app, text) {
+  app.document.getElementById("todo-input").value = text;
+  app.document
+    .getElementById("todo-form")
+    .dispatchEvent(new app.window.Event("submit", { bubbles: true, cancelable: true }));
+}
+
+function persisted(app) {
+  return app.window.localStorage.getItem(STORAGE_KEY);
+}
+
+test("adds a nonblank task, trims it, and persists it", () => {
+  const app = mount();
+  addTask(app, "  Buy milk  ");
+
+  const tasks = visibleTasks(app);
+  assert.equal(tasks.length, 1);
+  assert.equal(tasks[0].text, "Buy milk");
+  assert.equal(tasks[0].completed, false);
+  assert.equal(app.document.getElementById("todo-input").value, "");
+  assert.deepEqual(JSON.parse(persisted(app)).map((t) => t.text), ["Buy milk"]);
+
+  app.jsdom.window.close();
+});
+
+test("rejects blank and whitespace-only tasks without persisting", () => {
+  const app = mount();
+  for (const blank of ["", "   ", "\t\n "]) addTask(app, blank);
+
+  assert.equal(visibleTasks(app).length, 0);
+  assert.equal(persisted(app), null);
+  assert.match(app.document.getElementById("todo-status").textContent, /Enter a task/);
+
+  app.jsdom.window.close();
+});
+
+test("marks a task complete and then incomplete", () => {
+  const app = mount();
+  addTask(app, "Walk the dog");
+
+  app.document.querySelector('li[data-task-id] input[type="checkbox"]').click();
+  let [task] = visibleTasks(app);
+  assert.equal(task.completed, true);
+  assert.equal(task.checked, true);
+  assert.equal(JSON.parse(persisted(app))[0].completed, true);
+
+  app.document.querySelector('li[data-task-id] input[type="checkbox"]').click();
+  [task] = visibleTasks(app);
+  assert.equal(task.completed, false);
+  assert.equal(task.checked, false);
+  assert.equal(JSON.parse(persisted(app))[0].completed, false);
+
+  app.jsdom.window.close();
+});
+
+test("deletes only the targeted task", () => {
+  const app = mount();
+  addTask(app, "One");
+  addTask(app, "Two");
+  assert.equal(visibleTasks(app).length, 2);
+
+  app.document.querySelectorAll("li[data-task-id] .delete")[0].click();
+
+  assert.deepEqual(visibleTasks(app).map((t) => t.text), ["Two"]);
+  assert.deepEqual(JSON.parse(persisted(app)).map((t) => t.text), ["Two"]);
+
+  app.jsdom.window.close();
+});
+
+test("preserves tasks and completion state across a reload", () => {
+  const first = mount();
+  addTask(first, "First");
+  addTask(first, "Second");
+  first.document.querySelectorAll('li[data-task-id] input[type="checkbox"]')[1].click();
+
+  const second = reload(first);
+
+  assert.deepEqual(second.document.querySelectorAll("li[data-task-id]").length, 2);
+  assert.deepEqual(visibleTasks(second).map((t) => t.text), ["First", "Second"]);
+  assert.deepEqual(visibleTasks(second).map((t) => t.completed), [false, true]);
+
+  first.jsdom.window.close();
+  second.jsdom.window.close();
+});
+
+test("recovers from corrupted storage and keeps working", () => {
+  const app = mount({ [STORAGE_KEY]: "{not valid json" });
+
+  assert.equal(visibleTasks(app).length, 0);
+  addTask(app, "Recovered");
+  assert.deepEqual(visibleTasks(app).map((t) => t.text), ["Recovered"]);
+
+  app.jsdom.window.close();
+});
+
+test("ignores malformed stored entries", () => {
+  const app = mount({
+    [STORAGE_KEY]: JSON.stringify([
+      { id: "a", text: "valid", completed: false },
+      { id: "b", text: "  ", completed: false },
+      { nope: true },
+      null,
+    ]),
+  });
+
+  assert.deepEqual(visibleTasks(app).map((t) => t.text), ["valid"]);
+
+  app.jsdom.window.close();
+});
