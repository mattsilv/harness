+export const STORAGE_KEY = "todo.tasks.v1";
+
+export function normalizeTaskText(text) {
+  return typeof text === "string" ? text.trim() : "";
+}
+
+function isTask(value) {
+  return (
+    value !== null &&
+    typeof value === "object" &&
+    typeof value.id === "string" &&
+    typeof value.text === "string" &&
+    value.text.trim() !== "" &&
+    typeof value.completed === "boolean"
+  );
+}
+
+function newId() {
+  const cryptoObj = globalThis.crypto;
+  if (cryptoObj && typeof cryptoObj.randomUUID === "function") {
+    return cryptoObj.randomUUID();
+  }
+  return `task-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;
+}
+
+export function createTodoStore(storage, key = STORAGE_KEY) {
+  if (!storage) throw new Error("createTodoStore requires a storage object");
+
+  function read() {
+    const raw = storage.getItem(key);
+    if (!raw) return [];
+    let parsed;
+    try {
+      parsed = JSON.parse(raw);
+    } catch {
+      return [];
+    }
+    return Array.isArray(parsed) ? parsed.filter(isTask) : [];
+  }
+
+  function write(tasks) {
+    storage.setItem(key, JSON.stringify(tasks));
+  }
+
+  return {
+    list() {
+      return read();
+    },
+    add(text) {
+      const trimmed = normalizeTaskText(text);
+      if (!trimmed) return null;
+      const tasks = read();
+      const task = { id: newId(), text: trimmed, completed: false };
+      tasks.push(task);
+      write(tasks);
+      return task;
+    },
+    toggle(id) {
+      const tasks = read();
+      const task = tasks.find((candidate) => candidate.id === id);
+      if (!task) return null;
+      task.completed = !task.completed;
+      write(tasks);
+      return task;
+    },
+    remove(id) {
+      const tasks = read();
+      const remaining = tasks.filter((candidate) => candidate.id !== id);
+      if (remaining.length === tasks.length) return false;
+      write(remaining);
+      return true;
+    },
+  };
+}
+
+export function initTodoApp({ document: doc, storage, key = STORAGE_KEY }) {
+  const form = doc.getElementById("todo-form");
+  const input = doc.getElementById("todo-input");
+  const list = doc.getElementById("todo-list");
+  const status = doc.getElementById("todo-status");
+  if (!form || !input || !list || !status) {
+    throw new Error("To-do markup is missing required elements");
+  }
+
+  const store = createTodoStore(storage, key);
+
+  function renderTask(task) {
+    const item = doc.createElement("li");
+    item.dataset.taskId = task.id;
+    if (task.completed) item.classList.add("completed");
+
+    const checkbox = doc.createElement("input");
+    checkbox.type = "checkbox";
+    checkbox.checked = task.completed;
+    checkbox.setAttribute("aria-label", `Mark "${task.text}" complete`);
+    checkbox.addEventListener("change", () => {
+      store.toggle(task.id);
+      render();
+    });
+
+    const label = doc.createElement("span");
+    label.className = "text";
+    label.textContent = task.text;
+
+    const remove = doc.createElement("button");
+    remove.type = "button";
+    remove.className = "delete";
+    remove.textContent = "Delete";
+    remove.setAttribute("aria-label", `Delete "${task.text}"`);
+    remove.addEventListener("click", () => {
+      store.remove(task.id);
+      render();
+    });
+
+    item.append(checkbox, label, remove);
+    return item;
+  }
+
+  function render() {
+    const tasks = store.list();
+    list.textContent = "";
+    if (tasks.length === 0) {
+      const empty = doc.createElement("li");
+      empty.className = "empty";
+      empty.textContent = "No tasks yet.";
+      list.append(empty);
+      return;
+    }
+    for (const task of tasks) list.append(renderTask(task));
+  }
+
+  form.addEventListener("submit", (event) => {
+    event.preventDefault();
+    const added = store.add(input.value);
+    if (!added) {
+      status.textContent = "Enter a task before adding.";
+      input.focus();
+      return;
+    }
+    input.value = "";
+    status.textContent = "";
+    render();
+  });
+
+  render();
+  return store;
+}
+
+function autoInit() {
+  if (typeof document === "undefined") return;
+  if (!document.getElementById("todo-form")) return;
+  initTodoApp({ document, storage: window.localStorage });
+}
+
+if (typeof document !== "undefined") {
+  if (document.readyState === "loading") {
+    document.addEventListener("DOMContentLoaded", autoInit, { once: true });
+  } else {
+    autoInit();
+  }
+}
