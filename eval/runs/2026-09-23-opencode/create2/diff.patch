+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { mount } = require('../app.js');
+const { createDocument } = require('./fake-dom.js');
+
+const html = fs.readFileSync(path.join(__dirname, '..', 'index.html'), 'utf8');
+
+function idsFromHtml(source) {
+  const ids = {};
+  const re = /id="([^"]+)"/g;
+  let match;
+  while ((match = re.exec(source))) ids[match[1]] = 'div';
+  return ids;
+}
+
+function memoryStorage() {
+  const data = new Map();
+  return {
+    getItem: (key) => (data.has(key) ? data.get(key) : null),
+    setItem: (key, value) => { data.set(key, String(value)); },
+    removeItem: (key) => { data.delete(key); }
+  };
+}
+
+test('index.html wires the ids and scripts the app expects', () => {
+  const ids = idsFromHtml(html);
+  ['add-form', 'new-task', 'task-list', 'error', 'summary'].forEach((id) => {
+    assert.ok(ids[id], 'index.html is missing #' + id);
+  });
+  assert.match(html, /src="todo\.js"/);
+  assert.match(html, /src="app\.js"/);
+  assert.match(html, /TodoApp\.mount\(document, window\.localStorage\)/);
+});
+
+test('the real page markup drives add, toggle, and delete', () => {
+  const doc = createDocument(idsFromHtml(html));
+  const store = mount(doc, memoryStorage());
+
+  doc.getElementById('new-task').value = 'Real markup task';
+  doc.getElementById('add-form').dispatch('submit');
+  assert.equal(store.list().length, 1);
+
+  const item = doc.getElementById('task-list').children[0];
+  item.children[0].checked = true;
+  item.children[0].dispatch('change');
+  assert.equal(store.list()[0].done, true);
+
+  doc.getElementById('task-list').children[0].children[2].dispatch('click');
+  assert.equal(store.list().length, 0);
+});
