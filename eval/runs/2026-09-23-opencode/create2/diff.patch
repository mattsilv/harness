+(function (root, factory) {
+  'use strict';
+  if (typeof module === 'object' && module.exports) {
+    module.exports = factory(require('./todo.js'));
+  } else {
+    root.TodoApp = factory(root.TodoStore);
+  }
+})(typeof globalThis !== 'undefined' ? globalThis : this, function (TodoStore) {
+  'use strict';
+
+  function mount(doc, storage) {
+    var store = TodoStore.createStore(storage);
+    var form = doc.getElementById('add-form');
+    var input = doc.getElementById('new-task');
+    var list = doc.getElementById('task-list');
+    var error = doc.getElementById('error');
+    var summary = doc.getElementById('summary');
+
+    function render() {
+      var tasks = store.list();
+      list.textContent = '';
+
+      if (tasks.length === 0) {
+        var empty = doc.createElement('li');
+        empty.className = 'empty';
+        empty.textContent = 'No tasks yet.';
+        list.appendChild(empty);
+      }
+
+      tasks.forEach(function (task) {
+        var item = doc.createElement('li');
+        item.className = task.done ? 'done' : '';
+
+        var checkbox = doc.createElement('input');
+        checkbox.type = 'checkbox';
+        checkbox.checked = task.done;
+        checkbox.setAttribute('aria-label', 'Mark "' + task.text + '" complete');
+        checkbox.addEventListener('change', function () {
+          store.toggle(task.id);
+          render();
+        });
+
+        var text = doc.createElement('span');
+        text.className = 'text';
+        text.textContent = task.text;
+
+        var del = doc.createElement('button');
+        del.type = 'button';
+        del.className = 'delete';
+        del.textContent = 'Delete';
+        del.setAttribute('aria-label', 'Delete "' + task.text + '"');
+        del.addEventListener('click', function () {
+          store.remove(task.id);
+          render();
+        });
+
+        item.appendChild(checkbox);
+        item.appendChild(text);
+        item.appendChild(del);
+        list.appendChild(item);
+      });
+
+      var remaining = tasks.filter(function (t) { return !t.done; }).length;
+      summary.textContent = tasks.length === 0
+        ? ''
+        : remaining + ' of ' + tasks.length + ' remaining';
+    }
+
+    form.addEventListener('submit', function (event) {
+      event.preventDefault();
+      try {
+        store.add(input.value);
+        input.value = '';
+        error.textContent = '';
+        render();
+      } catch (err) {
+        error.textContent = err.message;
+      }
+    });
+
+    render();
+    return store;
+  }
+
+  return { mount: mount };
+});
