+(function (root, factory) {
+  'use strict';
+  if (typeof module === 'object' && module.exports) {
+    module.exports = factory();
+  } else {
+    root.TodoStore = factory();
+  }
+})(typeof globalThis !== 'undefined' ? globalThis : this, function () {
+  'use strict';
+
+  var STORAGE_KEY = 'todos.v1';
+
+  function isBlank(text) {
+    return typeof text !== 'string' || text.trim() === '';
+  }
+
+  function defaultMakeId() {
+    return 't' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
+  }
+
+  function normalize(raw) {
+    if (!raw || typeof raw !== 'object') return null;
+    if (typeof raw.id !== 'string' || raw.id === '') return null;
+    if (isBlank(raw.text)) return null;
+    return { id: raw.id, text: raw.text.trim(), done: raw.done === true };
+  }
+
+  function createStore(storage, options) {
+    options = options || {};
+    var key = options.key || STORAGE_KEY;
+    var makeId = options.makeId || defaultMakeId;
+    var tasks = load();
+
+    function load() {
+      var raw;
+      try {
+        raw = storage.getItem(key);
+      } catch (err) {
