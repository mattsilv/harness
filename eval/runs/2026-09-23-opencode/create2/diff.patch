@@ -0,0 +1,98 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { createStore, STORAGE_KEY } = require('../todo.js');
+
+function fakeStorage(initial) {
+  const data = new Map(Object.entries(initial || {}));
+  return {
+    data,
+    getItem: (key) => (data.has(key) ? data.get(key) : null),
+    setItem: (key, value) => { data.set(key, String(value)); },
+    removeItem: (key) => { data.delete(key); }
+  };
+}
+
+test('add stores a trimmed, incomplete task', () => {
+  const store = createStore(fakeStorage());
+  const task = store.add('  Buy milk  ');
+
+  assert.equal(task.text, 'Buy milk');
+  assert.equal(task.done, false);
+  assert.ok(task.id);
+  assert.deepEqual(store.list(), [task]);
+});
+
+test('add rejects blank, whitespace-only, and non-string text', () => {
+  const store = createStore(fakeStorage());
+
+  assert.throws(() => store.add(''), /blank/);
+  assert.throws(() => store.add('   '), /blank/);
+  assert.throws(() => store.add('\t\n '), /blank/);
+  assert.throws(() => store.add(undefined), /blank/);
+  assert.throws(() => store.add(42), /blank/);
+  assert.deepEqual(store.list(), []);
+});
+
+test('toggle marks a task complete and then incomplete', () => {
+  const store = createStore(fakeStorage());
+  const task = store.add('Walk the dog');
+
+  assert.equal(store.toggle(task.id).done, true);
+  assert.equal(store.list()[0].done, true);
+
+  assert.equal(store.toggle(task.id).done, false);
+  assert.equal(store.list()[0].done, false);
+
+  assert.equal(store.toggle('missing-id'), null);
+});
+
+test('remove deletes only the matching task', () => {
+  const store = createStore(fakeStorage());
+  const a = store.add('A');
+  const b = store.add('B');
+
+  assert.equal(store.remove(a.id), true);
+  assert.deepEqual(store.list().map((t) => t.text), ['B']);
+  assert.equal(store.remove(a.id), false);
+  assert.equal(store.remove('missing-id'), false);
+  assert.deepEqual(store.list().map((t) => t.id), [b.id]);
+});
+
+test('tasks and their state persist across a reload', () => {
+  const storage = fakeStorage();
+  const first = createStore(storage);
+  first.add('First');
+  const second = first.add('Second');
+  first.toggle(second.id);
+
+  const reloaded = createStore(storage);
+  assert.deepEqual(
+    reloaded.list().map((t) => ({ text: t.text, done: t.done })),
+    [
+      { text: 'First', done: false },
+      { text: 'Second', done: true }
+    ]
+  );
+  assert.equal(reloaded.list()[1].id, second.id);
+  assert.ok(storage.getItem(STORAGE_KEY));
+});
+
+test('corrupt or malformed storage degrades to a clean list', () => {
+  assert.deepEqual(createStore(fakeStorage({ [STORAGE_KEY]: '{not json' })).list(), []);
+  assert.deepEqual(createStore(fakeStorage({ [STORAGE_KEY]: '"nope"' })).list(), []);
+  assert.deepEqual(
+    createStore(fakeStorage({
+      [STORAGE_KEY]: JSON.stringify([
+        { id: 'ok', text: 'Keep me', done: false },
+        { id: '', text: 'No id', done: false },
+        { id: 'x', text: '   ', done: false },
+        null,
+        'junk'
+      ])
+    })).list(),
+    [{ id: 'ok', text: 'Keep me', done: false }]
+  );
+});
