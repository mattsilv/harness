+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { mount } = require('../app.js');
+const { createDocument } = require('./fake-dom.js');
+
+const IDS = {
+  'add-form': 'form',
+  'new-task': 'input',
+  'task-list': 'ul',
+  error: 'p',
+  summary: 'p'
+};
+
+function newStorage(initial) {
+  const data = new Map(Object.entries(initial || {}));
+  return {
+    data,
+    getItem: (key) => (data.has(key) ? data.get(key) : null),
+    setItem: (key, value) => { data.set(key, String(value)); },
+    removeItem: (key) => { data.delete(key); }
+  };
+}
+
+function setup(storage) {
+  const doc = createDocument(IDS);
+  const store = mount(doc, storage || newStorage());
+  return { doc, store };
+}
+
+function submit(doc, text) {
+  doc.getElementById('new-task').value = text;
+  doc.getElementById('add-form').dispatch('submit');
+}
+
+function items(doc) {
+  return doc.getElementById('task-list').children;
+}
+
+test('submitting a nonblank task adds it and clears the input', () => {
+  const { doc, store } = setup();
+  submit(doc, '  Buy milk  ');
+
+  assert.deepEqual(store.list().map((t) => t.text), ['Buy milk']);
+  assert.equal(doc.getElementById('new-task').value, '');
+  assert.equal(doc.getElementById('error').textContent, '');
+  assert.equal(items(doc).length, 1);
+  assert.equal(items(doc)[0].children[1].textContent, 'Buy milk');
+  assert.match(doc.getElementById('summary').textContent, /1 of 1 remaining/);
+});
+
+test('blank input shows an error and adds nothing', () => {
+  const { doc, store } = setup();
+  submit(doc, '   ');
+
+  assert.deepEqual(store.list(), []);
+  assert.match(doc.getElementById('error').textContent, /blank/i);
+  assert.equal(items(doc).length, 1);
+  assert.equal(items(doc)[0].className, 'empty');
+});
+
+test('the checkbox toggles a task complete and back', () => {
+  const { doc, store } = setup();
+  submit(doc, 'Walk the dog');
+
+  items(doc)[0].children[0].checked = true;
+  items(doc)[0].children[0].dispatch('change');
+  assert.equal(store.list()[0].done, true);
+  assert.equal(items(doc)[0].className, 'done');
+  assert.equal(items(doc)[0].children[0].checked, true);
+
+  items(doc)[0].children[0].checked = false;
+  items(doc)[0].children[0].dispatch('change');
+  assert.equal(store.list()[0].done, false);
+  assert.equal(items(doc)[0].className, '');
+});
+
+test('the delete button removes only that task', () => {
+  const { doc, store } = setup();
+  submit(doc, 'A');
+  submit(doc, 'B');
+
+  items(doc)[1].children[2].dispatch('click');
+
+  assert.deepEqual(store.list().map((t) => t.text), ['A']);
+  assert.equal(items(doc).length, 1);
+});
+
+test('a reload restores tasks and their completed state', () => {
+  const storage = newStorage();
+  const first = setup(storage);
+  submit(first.doc, 'A');
+  submit(first.doc, 'B');
+  items(first.doc)[1].children[0].checked = true;
+  items(first.doc)[1].children[0].dispatch('change');
+
+  const reloaded = setup(storage);
+  assert.deepEqual(
+    reloaded.store.list().map((t) => ({ text: t.text, done: t.done })),
+    [
+      { text: 'A', done: false },
+      { text: 'B', done: true }
+    ]
+  );
+  assert.equal(items(reloaded.doc).length, 2);
+  assert.equal(items(reloaded.doc)[1].className, 'done');
+  assert.equal(items(reloaded.doc)[1].children[0].checked, true);
+});
