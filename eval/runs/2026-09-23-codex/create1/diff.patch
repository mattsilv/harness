+<!doctype html>
+<html lang="en">
+  <head>
+    <meta charset="utf-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1" />
+    <meta name="theme-color" content="#f7f6f2" />
+    <title>Today — a small to-do list</title>
+    <style>
+      :root {
+        color-scheme: light;
+        font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+        color: #262923;
+        background: #f7f6f2;
+        font-synthesis: none;
+      }
+
+      * { box-sizing: border-box; }
+
+      body { margin: 0; min-height: 100vh; }
+
+      main {
+        width: min(100% - 40px, 620px);
+        margin: clamp(48px, 11vh, 112px) auto 48px;
+      }
+
+      .eyebrow {
+        margin: 0 0 12px;
+        color: #687366;
+        font-size: 12px;
+        font-weight: 700;
+        letter-spacing: .16em;
+        text-transform: uppercase;
+      }
+
+      h1 {
+        margin: 0;
+        font-size: clamp(42px, 9vw, 64px);
+        font-weight: 650;
+        letter-spacing: -.055em;
+        line-height: 1.05;
+      }
+
+      .intro { margin: 16px 0 32px; color: #687066; font-size: 16px; }
+
+      form { display: flex; gap: 10px; margin-bottom: 36px; }
+
+      input[type="text"] {
+        min-width: 0;
+        flex: 1;
+        height: 52px;
+        padding: 0 17px;
+        border: 1px solid #d9ded4;
+        border-radius: 12px;
+        background: #fff;
+        color: inherit;
+        font: inherit;
+        box-shadow: 0 2px 8px #222b2008;
+      }
+
+      input[type="text"]::placeholder { color: #92998f; }
+      input[type="text"]:focus { outline: 2px solid #477751; outline-offset: 2px; }
+
+      button { font: inherit; cursor: pointer; }
+
+      .add-button {
+        min-width: 84px;
+        height: 52px;
+        padding: 0 20px;
+        border: 0;
+        border-radius: 12px;
+        background: #315c3d;
+        color: white;
+        font-weight: 650;
+      }
+
+      .add-button:hover { background: #254b30; }
+
+      .list-heading {
+        display: flex;
+        align-items: baseline;
+        justify-content: space-between;
+        gap: 16px;
+        padding-bottom: 12px;
+        border-bottom: 1px solid #dedfd7;
+      }
+
+      h2 { margin: 0; font-size: 18px; letter-spacing: -.02em; }
+      #count { color: #687066; font-size: 14px; }
+      #tasks { list-style: none; margin: 0; padding: 0; }
+
+      .task {
+        display: flex;
+        align-items: center;
+        gap: 13px;
+        min-height: 65px;
+        padding: 11px 0;
+        border-bottom: 1px solid #e7e8e1;
+      }
+
+      .task input[type="checkbox"] {
+        width: 20px;
+        height: 20px;
+        margin: 0;
+        flex: none;
+        accent-color: #315c3d;
+        cursor: pointer;
+      }
+
+      .task label { flex: 1; min-width: 0; overflow-wrap: anywhere; cursor: pointer; }
+      .task input:checked + label { color: #858c82; text-decoration: line-through; }
+
+      .delete-button {
+        border: 0;
+        border-radius: 8px;
+        padding: 8px 10px;
+        background: transparent;
+        color: #70786e;
+        font-size: 13px;
+      }
+
+      .delete-button:hover { background: #e9eae3; color: #30382f; }
+      button:focus-visible, input[type="checkbox"]:focus-visible { outline: 2px solid #477751; outline-offset: 3px; }
+
+      #empty { padding: 30px 0; color: #737b71; text-align: center; }
+      footer { margin-top: 32px; color: #899087; font-size: 13px; }
+
+      @media (max-width: 480px) {
+        main { width: min(100% - 32px, 620px); margin-top: 48px; }
+        .intro { margin-bottom: 26px; }
+        form { margin-bottom: 30px; }
+        .add-button { min-width: 72px; padding: 0 14px; }
+      }
+    </style>
+  </head>
+  <body>
+    <main>
+      <p class="eyebrow">Your space to focus</p>
+      <h1>Today.</h1>
+      <p class="intro">A simple place for what needs doing.</p>
+
+      <form id="add-form">
+        <input id="new-task" type="text" aria-label="New task" placeholder="Add a task…" autocomplete="off" maxlength="500" required />
+        <button class="add-button" type="submit">Add</button>
+      </form>
+
+      <section aria-labelledby="tasks-heading">
+        <div class="list-heading">
+          <h2 id="tasks-heading">Your tasks</h2>
+          <span id="count" aria-live="polite"></span>
+        </div>
+        <ul id="tasks"></ul>
+        <p id="empty">Nothing on your list yet.</p>
+      </section>
+      <footer id="storage-status" aria-live="polite">Saved on this device.</footer>
+    </main>
+
+    <script>
+      (() => {
+        const storageKey = "today.tasks.v1";
+        const form = document.querySelector("#add-form");
+        const input = document.querySelector("#new-task");
+        const list = document.querySelector("#tasks");
+        const empty = document.querySelector("#empty");
+        const count = document.querySelector("#count");
+        const storageStatus = document.querySelector("#storage-status");
+
+        function loadTasks() {
+          try {
+            const saved = JSON.parse(localStorage.getItem(storageKey) || "[]");
+            if (!Array.isArray(saved)) return [];
+            return saved.filter(task => task && typeof task.id === "string" && typeof task.text === "string" && task.text.trim() && typeof task.done === "boolean");
+          } catch {
+            return [];
+          }
+        }
+
+        let tasks = loadTasks();
+
+        function saveTasks() {
+          try {
+            localStorage.setItem(storageKey, JSON.stringify(tasks));
+            storageStatus.textContent = "Saved on this device.";
+          } catch {
+            storageStatus.textContent = "Could not save on this device. Changes may be lost on reload.";
+          }
+        }
+
+        function updateCount() {
+          const remaining = tasks.filter(task => !task.done).length;
+          count.textContent = `${remaining} remaining`;
+        }
+
+        function render() {
+          list.replaceChildren();
+          for (const task of tasks) {
+            const item = document.createElement("li");
+            item.className = "task";
+
+            const checkbox = document.createElement("input");
+            checkbox.type = "checkbox";
+            checkbox.id = `task-${task.id}`;
+            checkbox.checked = task.done;
+            checkbox.addEventListener("change", () => {
+              task.done = checkbox.checked;
+              saveTasks();
+              updateCount();
+            });
+
+            const label = document.createElement("label");
+            label.htmlFor = checkbox.id;
+            label.textContent = task.text;
+
+            const remove = document.createElement("button");
+            remove.type = "button";
+            remove.className = "delete-button";
+            remove.textContent = "Delete";
+            remove.setAttribute("aria-label", `Delete ${task.text}`);
+            remove.addEventListener("click", () => {
+              const removedIndex = tasks.findIndex(candidate => candidate.id === task.id);
+              tasks = tasks.filter(candidate => candidate.id !== task.id);
+              saveTasks();
+              render();
+              (list.querySelectorAll('input[type="checkbox"]')[Math.min(removedIndex, tasks.length - 1)] || input).focus();
+            });
+
+            item.append(checkbox, label, remove);
+            list.append(item);
+          }
+
+          updateCount();
+          empty.hidden = tasks.length > 0;
+        }
+
+        form.addEventListener("submit", event => {
+          event.preventDefault();
+          const text = input.value.trim();
+          if (!text) return;
+          tasks.push({ id: crypto.randomUUID(), text, done: false });
+          saveTasks();
+          input.value = "";
+          render();
+          input.focus();
+        });
+
+        render();
+      })();
+    </script>
+  </body>
+</html>
