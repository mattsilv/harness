diff --git a/tests/todo.test.mjs b/tests/todo.test.mjs
new file mode 100644
index 0000000..b863abd
--- /dev/null
+++ b/tests/todo.test.mjs
@@ -0,0 +1,69 @@
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { readFile } from "node:fs/promises";
+import { test } from "node:test";
+import { chromium } from "playwright";
+
+const html = await readFile(new URL("../index.html", import.meta.url));
+
+test("tasks can be added, completed, reopened, deleted, and survive reloads", async () => {
+  const server = createServer((_request, response) => {
+    response.writeHead(200, { "content-type": "text/html; charset=utf-8" });
+    response.end(html);
+  });
+  await new Promise(resolve => server.listen(0, "127.0.0.1", resolve));
+
+  const browser = await chromium.launch();
+  try {
+    const page = await browser.newPage();
+    await page.goto(`http://127.0.0.1:${server.address().port}`);
+
+    const input = page.getByRole("textbox", { name: "New task" });
+    const add = page.getByRole("button", { name: "Add" });
+    const tasks = page.locator("#tasks li");
+
+    await input.fill("   ");
+    await add.click();
+    assert.equal(await tasks.count(), 0, "blank tasks are rejected");
+
+    await input.fill("  Buy groceries  ");
+    await add.click();
+    assert.equal(await tasks.count(), 1);
+    assert.equal(await tasks.first().locator("label").textContent(), "Buy groceries");
+    assert.equal(await page.locator("#count").textContent(), "1 remaining");
+
+    await page.reload();
+    assert.equal(await tasks.count(), 1, "added task survives reload");
+
+    const checkbox = page.getByRole("checkbox", { name: "Buy groceries" });
+    await checkbox.check();
+    assert.equal(await page.locator("#count").textContent(), "0 remaining");
+    assert.equal(await checkbox.evaluate(element => document.activeElement === element), true, "toggling keeps keyboard focus");
+    await page.reload();
+    assert.equal(await checkbox.isChecked(), true, "completed state survives reload");
+
+    await checkbox.uncheck();
+    await page.reload();
+    assert.equal(await checkbox.isChecked(), false, "incomplete state survives reload");
+
+    await page.getByRole("button", { name: "Delete Buy groceries" }).click();
+    assert.equal(await tasks.count(), 0);
+    assert.equal(await input.evaluate(element => document.activeElement === element), true, "deleting the last task moves focus to the input");
+    await page.reload();
+    assert.equal(await tasks.count(), 0, "deletion survives reload");
+    assert.equal(await page.locator("#empty").isVisible(), true);
+
+    const blockedPage = await browser.newPage();
+    await blockedPage.addInitScript(() => {
+      Storage.prototype.setItem = () => { throw new DOMException("Storage blocked", "QuotaExceededError"); };
+    });
+    await blockedPage.goto(`http://127.0.0.1:${server.address().port}`);
+    await blockedPage.getByRole("textbox", { name: "New task" }).fill("Unsaved task");
+    await blockedPage.getByRole("button", { name: "Add" }).click();
+    assert.equal(await blockedPage.locator("#tasks li").count(), 1);
+    assert.match(await blockedPage.locator("#storage-status").textContent(), /Could not save/);
+  } finally {
+    await browser.close();
+    await new Promise(resolve => server.close(resolve));
+  }
+});
