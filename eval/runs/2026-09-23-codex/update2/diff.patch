diff --git a/tests/todo.test.mjs b/tests/todo.test.mjs
new file mode 100644
index 0000000..f5e9b43
--- /dev/null
+++ b/tests/todo.test.mjs
@@ -0,0 +1,101 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { test } from 'node:test';
+import vm from 'node:vm';
+
+const html = readFileSync(new URL('../index.html', import.meta.url), 'utf8');
+const script = html.match(/<script>([\s\S]*?)<\/script>/)?.[1];
+assert.ok(script, 'app script exists');
+
+function openApp(storage) {
+  class Element {
+    constructor(tag = 'div') {
+      this.tagName = tag;
+      this.children = [];
+      this.attributes = {};
+      this.dataset = {};
+      this.value = '';
+      this.checked = false;
+      this.textContent = '';
+    }
+    setAttribute(name, value) { this.attributes[name] = value; }
+    replaceChildren(...children) { this.children = children; }
+    append(...children) { this.children.push(...children); }
+  }
+
+  const list = new Element('ul');
+  const input = new Element('input');
+  const form = new Element('form');
+  const filters = ['all', 'active', 'completed'].map((name) => {
+    assert.match(html, new RegExp(`<button[^>]*data-filter="${name}"[^>]*>${name[0].toUpperCase()}${name.slice(1)}</button>`));
+    const button = new Element('button');
+    button.dataset.filter = name;
+    return button;
+  });
+  const elements = { list, text: input, add: form };
+  const document = {
+    getElementById: (id) => elements[id],
+    querySelectorAll: (selector) => {
+      assert.equal(selector, '[data-filter]');
+      return filters;
+    },
+    createElement: (tag) => new Element(tag),
+  };
+  const localStorage = {
+    getItem: (key) => storage.get(key) ?? null,
+    setItem: (key, value) => storage.set(key, value),
+  };
+  vm.runInNewContext(script, { document, localStorage, Date });
+
+  return {
+    list,
+    input,
+    form,
+    filters: Object.fromEntries(filters.map((button) => [button.dataset.filter, button])),
+    visible: () => list.children.map((item) => item.children[2].textContent),
+    add(text) {
+      input.value = text;
+      form.onsubmit({ preventDefault() {} });
+    },
+  };
+}
+
+test('filters saved tasks and preserves add, toggle, delete, and reload behavior', () => {
+  const storage = new Map([['todos', JSON.stringify([
+    { id: 1, text: 'Open task', done: false },
+    { id: 2, text: 'Finished task', done: true },
+  ])]]);
+  let app = openApp(storage);
+  assert.deepEqual(app.visible(), ['Open task', 'Finished task']);
+  assert.equal(app.filters.all.attributes['aria-pressed'], 'true');
+
+  app.filters.active.onclick();
+  assert.deepEqual(app.visible(), ['Open task']);
+  assert.equal(app.filters.active.attributes['aria-pressed'], 'true');
+  assert.equal(app.filters.all.attributes['aria-pressed'], 'false');
+  app.add('New task');
+  assert.deepEqual(app.visible(), ['Open task', 'New task']);
+
+  app.list.children[0].children[0].checked = true;
+  app.list.children[0].children[0].onchange();
+  assert.deepEqual(app.visible(), ['New task']);
+  app.filters.completed.onclick();
+  assert.deepEqual(app.visible(), ['Open task', 'Finished task']);
+  app.filters.all.onclick();
+  assert.deepEqual(app.visible(), ['Open task', 'Finished task', 'New task']);
+  assert.equal(app.filters.all.attributes['aria-pressed'], 'true');
+  assert.equal(app.filters.completed.attributes['aria-pressed'], 'false');
+  app.filters.completed.onclick();
+  app.list.children[1].children[4].onclick();
+  assert.deepEqual(app.visible(), ['Open task']);
+
+  assert.deepEqual(JSON.parse(storage.get('todos')).map(({ text, done }) => [text, done]), [
+    ['Open task', true], ['New task', false],
+  ]);
+  app = openApp(storage);
+  assert.deepEqual(app.visible(), ['Open task', 'New task']);
+  app.filters.active.onclick();
+  assert.deepEqual(app.visible(), ['New task']);
+  app.filters.completed.onclick();
+  assert.deepEqual(app.visible(), ['Open task']);
+});
