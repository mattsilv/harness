+const assert = require("node:assert/strict");
+const test = require("node:test");
+const { createTaskStore } = require("../app.js");
+
+function memoryStorage() {
+  const values = new Map();
+  return {
+    getItem: (key) => values.get(key) ?? null,
+    setItem: (key, value) => values.set(key, value),
+  };
+}
+
+test("task lifecycle survives reloads", () => {
+  const storage = memoryStorage();
+  const open = () => createTaskStore(storage, () => "task-1");
+  let tasks = open();
+
+  assert.equal(tasks.add(" \n "), false);
+  assert.deepEqual(tasks.all(), []);
+  assert.equal(tasks.add("  Buy milk  "), true);
+  assert.deepEqual(tasks.all(), [{ id: "task-1", title: "Buy milk", completed: false }]);
+
+  tasks = open();
+  assert.equal(tasks.setCompleted("task-1", true), true);
+  assert.equal(open().all()[0].completed, true);
+  assert.equal(tasks.setCompleted("task-1", false), true);
+  assert.equal(open().all()[0].completed, false);
+
+  assert.equal(tasks.remove("task-1"), true);
+  assert.deepEqual(open().all(), []);
+});
+
+test("invalid saved data does not prevent the app from opening", () => {
+  const storage = memoryStorage();
+  storage.setItem("local-todo.tasks.v1", "broken json");
+  const tasks = createTaskStore(storage, () => "new-task");
+  assert.deepEqual(tasks.all(), []);
+  assert.equal(tasks.add("Recover"), true);
+  assert.equal(createTaskStore(storage).all()[0].title, "Recover");
+});
+
+test("failed storage writes leave tasks unchanged", () => {
+  const storage = memoryStorage();
+  const tasks = createTaskStore(storage, () => "task-1");
+  const setItem = storage.setItem;
+
+  storage.setItem = () => { throw new Error("storage full"); };
+  assert.throws(() => tasks.add("Buy milk"), /storage full/);
+  assert.deepEqual(tasks.all(), []);
+
+  storage.setItem = setItem;
+  tasks.add("Buy milk");
+  storage.setItem = () => { throw new Error("storage full"); };
+  assert.throws(() => tasks.setCompleted("task-1", true), /storage full/);
+  assert.deepEqual(tasks.all(), [{ id: "task-1", title: "Buy milk", completed: false }]);
+  assert.throws(() => tasks.remove("task-1"), /storage full/);
+  assert.equal(createTaskStore(storage).all().length, 1);
+});
+
+test("sequential edits from two tabs preserve both tasks", () => {
+  const storage = memoryStorage();
+  const first = createTaskStore(storage, () => "first");
+  const second = createTaskStore(storage, () => "second");
+  first.add("First task");
+  second.add("Second task");
+  first.sync();
+  assert.deepEqual(first.all().map((task) => task.title), ["First task", "Second task"]);
+  assert.equal(createTaskStore(storage).all().length, 2);
+});
