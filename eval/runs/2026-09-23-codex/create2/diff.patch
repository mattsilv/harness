+const STORAGE_KEY = "local-todo.tasks.v1";
+
+function createTaskStore(storage, makeId = () => crypto.randomUUID()) {
+  function read() {
+    const raw = storage.getItem(STORAGE_KEY);
+    let saved;
+    try { saved = JSON.parse(raw ?? "[]"); } catch { return []; }
+    return Array.isArray(saved)
+      ? saved.filter((task) => task && typeof task.id === "string" && typeof task.title === "string" && typeof task.completed === "boolean")
+      : [];
+  }
+  let tasks;
+  try { tasks = read(); } catch { tasks = []; }
+
+  function persist(next) {
+    storage.setItem(STORAGE_KEY, JSON.stringify(next));
+    tasks = next;
+  }
+
+  return {
+    all: () => tasks.map((task) => ({ ...task })),
+    sync() {
+      tasks = read();
+    },
+    add(title) {
+      const trimmed = title.trim();
+      if (!trimmed) return false;
+      persist([...read(), { id: makeId(), title: trimmed, completed: false }]);
+      return true;
+    },
+    setCompleted(id, completed) {
+      const latest = read();
+      const task = latest.find((item) => item.id === id);
+      if (!task) { tasks = latest; return false; }
+      persist(latest.map((item) => item.id === id ? { ...item, completed } : item));
+      return true;
+    },
+    remove(id) {
+      const latest = read();
+      const next = latest.filter((task) => task.id !== id);
+      if (next.length === latest.length) { tasks = latest; return false; }
+      persist(next);
+      return true;
+    },
+  };
+}
+
+if (typeof module !== "undefined") module.exports = { createTaskStore };
+
+if (typeof document !== "undefined") {
+  const store = createTaskStore(localStorage);
+  const form = document.querySelector("#task-form");
+  const input = document.querySelector("#task-input");
+  const list = document.querySelector("#tasks");
+  const count = document.querySelector("#count");
+  const empty = document.querySelector("#empty");
+  const error = document.querySelector("#error");
+
+  function render(focusId) {
+    const tasks = store.all();
+    list.replaceChildren();
+    for (const task of tasks) {
+      const row = document.createElement("li");
+      const checkbox = document.createElement("input");
+      const label = document.createElement("label");
+      const button = document.createElement("button");
+
+      checkbox.type = "checkbox";
+      checkbox.id = `task-${task.id}`;
+      checkbox.checked = task.completed;
+      checkbox.addEventListener("change", () => {
+        try {
+          store.setCompleted(task.id, checkbox.checked);
+          error.hidden = true;
+        } catch {
+          error.hidden = false;
+        }
+        render(task.id);
+      });
+      label.htmlFor = checkbox.id;
+      label.textContent = task.title;
+      button.type = "button";
+      button.className = "delete";
+      button.textContent = "Delete";
+      button.setAttribute("aria-label", `Delete ${task.title}`);
+      button.addEventListener("click", () => {
+        const index = store.all().findIndex((item) => item.id === task.id);
+        const nextFocus = tasks[index + 1]?.id ?? tasks[index - 1]?.id;
+        try {
+          store.remove(task.id);
+          error.hidden = true;
+          render(nextFocus ?? "");
+        } catch {
+          error.hidden = false;
+          render(task.id);
+        }
+      });
+      if (task.completed) row.className = "completed";
+      row.append(checkbox, label, button);
+      list.append(row);
+    }
+    const remaining = tasks.filter((task) => !task.completed).length;
+    count.textContent = `${remaining} remaining`;
+    empty.hidden = tasks.length > 0;
+    if (focusId !== undefined) {
+      const checkbox = [...list.querySelectorAll("input")].find((item) => item.id === `task-${focusId}`);
+      (checkbox ?? input).focus();
+    }
+  }
+
+  form.addEventListener("submit", (event) => {
+    event.preventDefault();
+    try {
+      if (store.add(input.value)) {
+        input.value = "";
+        error.hidden = true;
+        render();
+      }
+    } catch {
+      error.hidden = false;
+    }
+    input.focus();
+  });
+  window.addEventListener("storage", (event) => {
+    if (event.key !== STORAGE_KEY) return;
+    try {
+      store.sync();
+      render();
+    } catch {
+      error.hidden = false;
+    }
+  });
+  render();
+}
