--- /dev/null
+++ b/tests/filters.test.mjs
@@ -0,0 +1,90 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import test from "node:test";
+import { runInNewContext } from "node:vm";
+
+const html = readFileSync(new URL("../index.html", import.meta.url), "utf8");
+const script = html.match(/<script>([\s\S]*?)<\/script>/)?.[1];
+assert.ok(script, "The app must have an inline script");
+
+function element() {
+  return {
+    children: [],
+    attributes: {},
+    append(...children) { this.children.push(...children); },
+    replaceChildren(...children) { this.children = children; },
+    setAttribute(name, value) { this.attributes[name] = value; },
+  };
+}
+
+function startApp(saved = new Map()) {
+  const buttons = [...html.matchAll(/<button type="button" data-filter="([^"]+)"/g)]
+    .map(([, filter]) => Object.assign(element(), { dataset: { filter } }));
+  const nodes = { add: element(), text: element(), list: element() };
+  const localStorage = {
+    getItem: (key) => saved.get(key) ?? null,
+    setItem: (key, value) => saved.set(key, value),
+  };
+  const document = {
+    getElementById: (id) => nodes[id],
+    querySelectorAll: (selector) => {
+      assert.equal(selector, "#filters button");
+      return buttons;
+    },
+    createElement: () => element(),
+  };
+  runInNewContext(script, { document, localStorage, Date });
+
+  const visible = () => nodes.list.children.map((li) => li.children[2].textContent);
+  const add = (text) => {
+    nodes.text.value = text;
+    nodes.add.onsubmit({ preventDefault() {} });
+  };
+  const select = (filter) => {
+    buttons.find((button) => button.dataset.filter === filter).onclick();
+    assert.deepEqual(buttons.map((button) => button.attributes["aria-pressed"]),
+      ["all", "active", "completed"].map((name) => String(name === filter)));
+  };
+  return { nodes, saved, visible, add, select };
+}
+
+test("filters saved tasks without changing storage, and reload starts on All", () => {
+  const tasks = [
+    { id: 1, text: "Open", done: false },
+    { id: 2, text: "Finished", done: true },
+  ];
+  const saved = new Map([["todos", JSON.stringify(tasks)]]);
+  const app = startApp(saved);
+
+  assert.deepEqual(app.visible(), ["Open", "Finished"]);
+  app.select("active");
+  assert.deepEqual(app.visible(), ["Open"]);
+  app.select("completed");
+  assert.deepEqual(app.visible(), ["Finished"]);
+  app.select("all");
+  assert.deepEqual(app.visible(), ["Open", "Finished"]);
+  assert.equal(saved.get("todos"), JSON.stringify(tasks));
+  assert.deepEqual(startApp(saved).visible(), ["Open", "Finished"]);
+});
+
+test("add, toggle, and delete still work while a filter is selected", () => {
+  const app = startApp();
+  app.select("active");
+  app.add("  New task  ");
+  assert.deepEqual(app.visible(), ["New task"]);
+  assert.equal(app.nodes.text.value, "");
+
+  const checkbox = app.nodes.list.children[0].children[0];
+  checkbox.checked = true;
+  checkbox.onchange();
+  assert.deepEqual(app.visible(), []);
+  assert.deepEqual(JSON.parse(app.saved.get("todos")).map(({ text, done }) => ({ text, done })),
+    [{ text: "New task", done: true }]);
+
+  app.select("completed");
+  assert.deepEqual(app.visible(), ["New task"]);
+  app.nodes.list.children[0].children[4].onclick();
+  assert.deepEqual(app.visible(), []);
+  assert.deepEqual(JSON.parse(app.saved.get("todos")), []);
+  assert.deepEqual(startApp(app.saved).visible(), []);
+});
